    async function restoreVisitorRoute(canonicalize = false) {
      const request = ++routeRequest;
      itemRequest += 1;
      setStatus(d.libraryStatus);
      cancelItemLoadingFeedback();
      clearSearch();

      const requestedPath = pseudoPathFromVisitorUrl(location.pathname);
      const path = requestedPath || "/root";
      if (!requestedPath || path === "/root") {
        const rootLoaded = await load("/root", "", "none");
        if (!rootLoaded || request !== routeRequest) return;
        updateVisitorUrl("/root", !requestedPath || canonicalize ? "replace" : "none");
        return;
      }

      if (isFileRoute(path)) {
        const [item, parentLoaded] = await Promise.all([
          requestItem(path, true),
          load(parentPseudoPath(path), "", "none")
        ]);
        if (!parentLoaded || request !== routeRequest) return;
        if (item) {
          await openItem(path, "none", item);
          if (request !== routeRequest) return;
          updateVisitorUrl(path, canonicalize ? "replace" : "none");
          return;
        }
      }

      const folderLoaded = await load(path, "", "none");
      if (!folderLoaded || request !== routeRequest) return;
      if (s.items.length) {
        updateVisitorUrl(path, canonicalize ? "replace" : "none");
        return;
      }

      let item: ItemPayload | null;
      try {
        item = await requestItem(path, true);
      } catch (error) {
        if (request !== routeRequest) return;
        throw error;
      }
      if (request !== routeRequest) return;
      if (item) {
        const parentLoaded = await load(parentPseudoPath(path), "", "none");
        if (!parentLoaded || request !== routeRequest) return;
        await openItem(path, "none", item);
      }
      if (request !== routeRequest) return;
      updateVisitorUrl(path, canonicalize ? "replace" : "none");
    }

    const saved = cookie.get("rp_l");
    if (saved === "zh" || saved === "ja" || saved === "en") s.lang = saved;
    d.language.value = s.lang;
    applyLanguage();
    window.addEventListener("pagehide", () => saveProgress(true));
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") saveProgress(true);

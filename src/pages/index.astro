    d.fullscreenToggle.addEventListener("click", () => toggleFullscreen().catch(() => undefined));
    const isMoviEventTarget = (target: EventTarget | null) => s.moviActive && (target === d.movi || (target instanceof Node && d.movi.contains(target)));
    const isVPlayerEventTarget = (target: EventTarget | null) => s.videoBackend === "vplayer" && target instanceof Node && d.vplayerHost.contains(target);

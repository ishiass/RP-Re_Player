      audioPath: document.querySelector<HTMLElement>("#audioPath")!,
      lyricsPanel: document.querySelector<HTMLElement>("#lyricsPanel")!,
      lyricsList: document.querySelector<HTMLElement>("#lyricsList")!,
      kind: document.querySelector<HTMLElement>("#kindBadge")!,
      subtitle: document.querySelector<HTMLElement>("#subtitleBadge")!,
      lyricsBadge: document.querySelector<HTMLElement>("#lyricsBadge")!,
      title: document.querySelector<HTMLElement>("#mediaTitle")!,
      mediaPath: document.querySelector<HTMLElement>("#mediaPath")!,
      playerStatus: document.querySelector<HTMLElement>("#playerStatus")!,
      playerStats: document.querySelector<HTMLElement>("#playerStats")!,
      playCount: document.querySelector<HTMLElement>("#playCount")!,
      completionRate: document.querySelector<HTMLElement>("#completionRate")!
    };
    let controlTimer = 0;
    let listRequest = 0;
    let itemRequest = 0;
    let routeRequest = 0;
    let searchTimer = 0;
    let videoClickTimer = 0;
    let videoHoldTimer = 0;
    let videoRewindTimer = 0;
    let videoHoldMode: "rewind" | "fast" | null = null;
    let videoHoldTriggered = false;
    let suppressVideoClick = false;
    let videoHoldRate = 1;
    let videoHoldX = 0;
    let videoHoldY = 0;
    let seeking = false;
    let audioSeeking = false;
    let statSession = 0;
    let statPlayed = false;
    let progressStamp = 0;
    const cookie = {
      get(name: string) {
        const value = document.cookie.split("; ").find((part) => part.startsWith(`${name}=`))?.slice(name.length + 1);
        if (!value) return "";
        try {
          return decodeURIComponent(value);
        } catch {
          return "";
        }
      },
      set(name: string, value: string, age = 31536000) {
        document.cookie = `${name}=${encodeURIComponent(value)}; Path=/; Max-Age=${age}; SameSite=Lax`;
      }
    };
    function parseProgress(raw: string): SavedProgress | null {
      try {
        const value = JSON.parse(raw) as SavedProgress;
        return typeof value?.p === "string" && Number.isFinite(value?.t) ? value : null;
      } catch {
        return null;
      }
    }

    function progressKey(path: string) {
      let a = 2166136261;
      let b = 5381;
      for (let i = 0; i < path.length; i += 1) {
        const code = path.charCodeAt(i);
        a = Math.imul(a ^ code, 16777619);
        b = Math.imul(b, 33) ^ code;
      }
      return `rp_p_${(a >>> 0).toString(36)}_${(b >>> 0).toString(36)}`;
    }

    function readProgress(path: string) {
      const current = parseProgress(cookie.get(progressKey(path)));
      if (current?.p === path) return current;
      const legacy = parseProgress(cookie.get("rp_p"));
      if (legacy?.p !== path) return null;
      cookie.set(progressKey(path), JSON.stringify(legacy));
      cookie.set("rp_p", "", 0);
      return legacy;
    }

    function activeMedia() {
      if (s.current?.kind === "video") return d.video;
      if (s.current?.kind === "audio") return d.audio;
      return null;
    }

    function saveProgress(force = false, complete = false) {
      const media = activeMedia();
      if (!media || !s.current || !Number.isFinite(media.currentTime)) return;
      const now = Date.now();
      if (!force && now - progressStamp < 5000) return;
      progressStamp = now;
      const duration = Number.isFinite(media.duration) && media.duration > 0 ? media.duration : undefined;
      const ended = Boolean(duration && (complete || media.ended || duration - media.currentTime <= 3));
      if (!ended && media.currentTime <= 0) return;
      const value: SavedProgress = {
        p: s.current.path,
        t: Math.round((ended && duration ? duration : media.currentTime) * 10) / 10
      };
      if (duration) value.d = Math.round(duration * 10) / 10;
      if (ended) value.e = 1;
      cookie.set(progressKey(s.current.path), JSON.stringify(value));
    }

    function restoreProgress(media: HTMLMediaElement) {
      if (!s.current) return;
      const saved = readProgress(s.current.path);
      if (!saved || saved.t <= 0) return;
      const duration = Number.isFinite(media.duration) && media.duration > 0 ? media.duration : undefined;
      media.currentTime = duration ? (saved.e ? duration : Math.min(saved.t, duration)) : saved.t;
    }
    let statCompleted = false;
    let statTask: Promise<void> = Promise.resolve();

    const VIDEO_RATES = [1, 1.25, 1.5, 2];

    const e: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
    const esc = (v: unknown) => String(v ?? "").replace(/[&<>"']/g, (x) => e[x]);
    const t = (k: keyof (typeof c)["en"]) => c[s.lang][k];
    const displayPath = (path: string) => path.replace(/^\/root(?=\/|$)/, "") || "/";
    function updateVisitorUrl(path: string, mode: NavigationMode) {
      if (mode === "none") return;
      const next = visitorUrl(path);
      if (location.pathname === next && !location.search && !location.hash) return;
      const state = { rpPath: path };
      if (mode === "replace") history.replaceState(state, "", next);
      else history.pushState(state, "", next);
    }
    const subtitleFontUrls = async (content: string) => {
      const characters = [...new Set([...content].filter((character) => {
        const point = character.codePointAt(0) || 0;
        return point >= 0x20 && point !== 0x7f;
      }))];
      const chunks = Array.from(
        { length: Math.max(1, Math.ceil(characters.length / 700)) },
        (_, part) => characters.slice(part * 700, (part + 1) * 700).join("")
      );
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 6000);
      try {
        const urls = await Promise.all(chunks.map(async (text) => {
          const url = new URL("https://fonts.googleapis.com/css2");
          url.searchParams.set("family", "Noto Sans SC:wght@400");
          url.searchParams.set("text", text);
          const response = await fetch(url, { signal: controller.signal });
          if (!response.ok) throw new Error("Font CSS request failed.");
          const css = await response.text();
          const font = css.match(/url\((https:\/\/[^)]+)\)/)?.[1];
          if (!font) throw new Error("Font URL was not found.");
          return font;
        }));
        const fonts = await Promise.all(urls.map(async (url) => {
          const response = await fetch(url, { signal: controller.signal });
          if (!response.ok) throw new Error("Font request failed.");
          return new Uint8Array(await response.arrayBuffer());
        }));
        return { fonts, defaultFont: "Noto Sans SC" };
      } catch {
        const kana = [...content].filter((character) => {
          const point = character.codePointAt(0) || 0;
          return point >= 0x3040 && point <= 0x30ff;
        }).length;
        const han = [...content].filter((character) => {
          const point = character.codePointAt(0) || 0;
          return point >= 0x4e00 && point <= 0x9fff;
        }).length;
        const japanese = kana * 3 > han;
        const url = japanese ? "/fonts/NotoSansJP-Regular.woff2" : "/fonts/NotoSansSC-Regular.woff2";
        const response = await fetch(url);
        return {
          fonts: response.ok ? [new Uint8Array(await response.arrayBuffer())] : [],
          defaultFont: japanese ? "Noto Sans JP" : "Noto Sans SC"
        };
      } finally {
        window.clearTimeout(timer);
      }
    };
    const normalizeAssFonts = (content: string, font: string) => {
      let styles = false;
      return content.split(/\r?\n/).map((line) => {
        if (/^\s*\[(V4\+? Styles)\]\s*$/i.test(line)) {
          styles = true;
          return line;
        }
        if (/^\s*\[.+\]\s*$/.test(line)) styles = false;
        if (styles && /^\s*Style\s*:/i.test(line)) {
          const fields = line.split(",");
          if (fields.length > 2) fields[1] = font;
          line = fields.join(",");
        }
        return line.replace(/\\fn[^\\}]+/g, `\\fn${font}`);
      }).join("\n");
    };
    const icon = (item: MediaItem) => {
      const id = item.isDir ? "iconFolder" : item.kind === "audio" ? "iconAudio" : item.kind === "image" ? "iconImage" : "iconVideo";
      return document.querySelector<HTMLTemplateElement>(`#${id}`)?.innerHTML ?? "";
    };
    const type = (item: MediaItem) => item.isDir ? "folder" : item.kind || "video";

    function setStatus(el: HTMLElement, message = "", tone = "") {
      el.textContent = message;
      tone ? (el.dataset.tone = tone) : delete el.dataset.tone;
    }

    function cancelItemLoadingFeedback() {
      if (d.stage.dataset.signal !== "transfer") return;
      delete d.stage.dataset.signal;
      setStatus(d.playerStatus);
    }

    function renderStats() {
      d.playerStats.hidden = !s.current;
      if (!s.current) return;
      d.playCount.textContent = `${t("playCount")}: ${s.stat.plays}`;
      d.completionRate.textContent = `${t("completionRate")}: ${s.stat.rate}%`;
    }

    function resetStatSession(stat?: MediaStat) {
      statSession += 1;
      statPlayed = false;
      statCompleted = false;
      if (stat) s.stat = stat;
      renderStats();
    }

    function recordStat(event: "play" | "complete") {
      if (!s.current) return Promise.resolve();
      if (event === "play") {
        if (statPlayed) return statTask;
        statPlayed = true;
      } else {
        if (statCompleted) return statTask;
        statCompleted = true;
      }

      const session = statSession;
      const path = s.current.path;
      if (event === "play") trackVisitor("play", path);
      statTask = statTask.catch(() => undefined).then(async () => {
        const response = await fetch("/api/public/stat", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ path, event })
        });
        const data = (await response.json()) as { ok?: boolean; stat?: MediaStat };
        if (!response.ok || !data.ok || !data.stat) return;
        if (session !== statSession || s.current?.path !== path) return;
        s.stat = data.stat;
        renderStats();
      }).catch(() => undefined);
      return statTask;
    }

    function recordPlay() {
      if (statCompleted) resetStatSession();
      return recordStat("play");
    }

    function trackVisitor(event: "visit" | "directory" | "media" | "play", path: string) {
      fetch("/api/public/track", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ event, path }),
        keepalive: true
      }).catch(() => undefined);
    }

    const formatTime = (seconds: number) => {
      if (!Number.isFinite(seconds) || seconds < 0) return "00:00";
      const whole = Math.floor(seconds);
      const hours = Math.floor(whole / 3600);
      const minutes = Math.floor((whole % 3600) / 60);
      const rest = whole % 60;
      return hours
        ? `${hours}:${String(minutes).padStart(2, "0")}:${String(rest).padStart(2, "0")}`
        : `${String(minutes).padStart(2, "0")}:${String(rest).padStart(2, "0")}`;
    };

    const setRangeFill = (input: HTMLInputElement, value: number) => {
      input.style.setProperty("--range-fill", `${Math.max(0, Math.min(100, value))}%`);
    };

    const libraryMedia = window.matchMedia("(max-width: 680px)");
    const touchMedia = window.matchMedia("(hover: none), (pointer: coarse)");
    const isMobileLibraryAvailable = () => libraryMedia.matches && (touchMedia.matches || navigator.maxTouchPoints > 0);
    function setLibraryOpen(open: boolean) {
      const available = isMobileLibraryAvailable();
      const active = available && open;
      d.app.classList.toggle("is-library-open", active);
      d.libraryToggle.hidden = !available;
      d.libraryToggle.disabled = !available;
      d.libraryToggle.ariaExpanded = String(active);
      d.libraryToggle.ariaHidden = String(!available);
      const label = t(active ? "hideLibrary" : "showLibrary");
      d.libraryToggle.title = d.libraryToggle.ariaLabel = label;
      d.libraryScrim.setAttribute("aria-hidden", String(!active));
      d.libraryScrim.ariaLabel = t("hideLibrary");
    }

    function updateMediaNavigation() {
      const update = (kind: "video" | "audio", queue: MediaItem[], previous: HTMLButtonElement, next: HTMLButtonElement) => {
        const active = s.current?.kind === kind;
        const index = active ? queue.findIndex((item) => item.path === s.current?.path) : -1;
        previous.disabled = index <= 0;
        next.disabled = index < 0 || index >= queue.length - 1;
        previous.title = previous.ariaLabel = t("previous");
        next.title = next.ariaLabel = t("next");
      };
      update("video", s.videoQueue, d.videoPrevious, d.videoNext);
      update("audio", s.audioQueue, d.audioPrevious, d.audioNext);
    }

    async function playAdjacent(kind: "video" | "audio", direction: -1 | 1) {
      if (s.current?.kind !== kind) return;
      const queue = kind === "audio" ? s.audioQueue : s.videoQueue;
      const index = queue.findIndex((item) => item.path === s.current?.path);
      const target = queue[index + direction];
      if (index < 0 || !target) return;
      await openItem(target.path);
    }

    function scheduleControls(delay = 4200) {
      window.clearTimeout(controlTimer);
      if (seeking) return;
      controlTimer = window.setTimeout(() => d.videoFrame.classList.add("controls-hidden"), delay);
    }

    function showControls(lock = false) {
      window.clearTimeout(controlTimer);
      d.videoFrame.classList.remove("controls-hidden");
      if (!lock) scheduleControls();
    }

    function hideControls() {
      window.clearTimeout(controlTimer);
      if (!seeking) d.videoFrame.classList.add("controls-hidden");
    }

    function toggleVideoControls() {
      if (d.videoFrame.classList.contains("controls-hidden")) showControls();
      else hideControls();
    }

    function cycleVideoSpeed() {
      const current = d.video.defaultPlaybackRate || d.video.playbackRate || 1;
      const index = VIDEO_RATES.findIndex((rate) => Math.abs(rate - current) < 0.01);
      const rate = VIDEO_RATES[(index + 1 + VIDEO_RATES.length) % VIDEO_RATES.length];
      d.video.defaultPlaybackRate = rate;
      d.video.playbackRate = rate;
      updateVideoControls();
    }

    function showVideoHoldFeedback(mode: "rewind" | "fast") {
      d.videoHoldFeedback.hidden = false;
      d.videoHoldFeedback.classList.toggle("is-rewind", mode === "rewind");
      d.videoHoldFeedback.classList.toggle("is-fast", mode === "fast");
      d.videoRewindIcon.hidden = mode !== "rewind";
      d.videoFastIcon.hidden = mode !== "fast";
      d.videoHoldLabel.textContent = mode === "rewind" ? "-2s" : "2×";
    }

    function stopVideoHold() {
      window.clearTimeout(videoHoldTimer);
      window.clearInterval(videoRewindTimer);
      const triggered = videoHoldTriggered;
      if (triggered && videoHoldMode === "fast") d.video.playbackRate = videoHoldRate;
      videoHoldTimer = 0;
      videoRewindTimer = 0;
      videoHoldMode = null;
      videoHoldTriggered = false;
      d.videoHoldFeedback.hidden = true;
      updateVideoControls();
      if (triggered) {
        suppressVideoClick = true;
        window.setTimeout(() => {
          suppressVideoClick = false;
        }, 350);
      }
    }

    function beginVideoHold(event: PointerEvent) {
      if (event.button !== 0 || d.videoControls.contains(event.target as Node)) return;
      stopVideoHold();
      const rect = d.videoFrame.getBoundingClientRect();
      const ratio = (event.clientX - rect.left) / rect.width;
      if (ratio > 1 / 6 && ratio < 5 / 6) return;
      videoHoldMode = ratio <= 1 / 6 ? "rewind" : "fast";
      videoHoldX = event.clientX;
      videoHoldY = event.clientY;
      videoHoldTimer = window.setTimeout(() => {
        if (!videoHoldMode || (videoHoldMode === "fast" && d.video.paused)) return;
        videoHoldTriggered = true;
        showVideoHoldFeedback(videoHoldMode);
        if (videoHoldMode === "fast") {
          videoHoldRate = d.video.playbackRate || 1;
          d.video.playbackRate = 2;
          updateVideoControls();
          return;
        }
        const rewind = () => {
          d.video.currentTime = Math.max(0, d.video.currentTime - 2);
        };
        rewind();
        videoRewindTimer = window.setInterval(rewind, 1000);
      }, 3000);
    }

    function moveVideoHold(event: PointerEvent) {
      if (!videoHoldMode || videoHoldTriggered) return;
      if (Math.hypot(event.clientX - videoHoldX, event.clientY - videoHoldY) > 18) stopVideoHold();
    }

    function updateVideoControls() {
      const paused = d.video.paused;
      const muted = d.video.muted || d.video.volume === 0;
      const fullscreen = isVideoFullscreen();
      const duration = Number.isFinite(d.video.duration) ? d.video.duration : 0;
      const rate = d.video.playbackRate || 1;
      d.videoFrame.dataset.playing = paused ? "0" : "1";
      d.playIcon.hidden = !paused;
      d.pauseIcon.hidden = paused;
      d.playToggle.title = d.playToggle.ariaLabel = t(paused ? "play" : "pause");
      d.volumeIcon.hidden = muted;
      d.mutedIcon.hidden = !muted;
      d.muteToggle.title = d.muteToggle.ariaLabel = t(muted ? "unmute" : "mute");
      d.speedValue.textContent = `${rate}×`;
      d.speedToggle.title = d.speedToggle.ariaLabel = `${t("speed")}: ${rate}×`;
      d.fullscreenIcon.hidden = fullscreen;
      d.exitFullscreenIcon.hidden = !fullscreen;
      d.fullscreenToggle.title = d.fullscreenToggle.ariaLabel = t(fullscreen ? "exitFullscreen" : "fullscreen");
      d.seek.ariaLabel = t("seek");
      d.volume.ariaLabel = t("volume");
      d.seek.max = String(duration);
      if (!seeking) d.seek.value = String(Math.min(d.video.currentTime || 0, duration));
      d.volume.value = String(muted ? 0 : d.video.volume);
      d.time.value = `${formatTime(d.video.currentTime)} / ${formatTime(duration)}`;
      setRangeFill(d.seek, duration ? (Number(d.seek.value) / duration) * 100 : 0);
      setRangeFill(d.volume, Number(d.volume.value) * 100);
    }

    function updateAudioControls() {
      const paused = d.audio.paused;
      const muted = d.audio.muted || d.audio.volume === 0;
      const duration = Number.isFinite(d.audio.duration) ? d.audio.duration : 0;
      const modeKey = s.audioMode === "one" ? "repeatOne" : s.audioMode === "list" ? "repeatList" : "shuffle";
      d.audioFrame.classList.toggle("is-playing", !paused);
      d.audioPlayIcon.hidden = !paused;
      d.audioPauseIcon.hidden = paused;
      d.audioPlayToggle.title = d.audioPlayToggle.ariaLabel = t(paused ? "play" : "pause");
      d.audioVolumeIcon.hidden = muted;
      d.audioMutedIcon.hidden = !muted;
      d.audioMuteToggle.title = d.audioMuteToggle.ariaLabel = t(muted ? "unmute" : "mute");
      d.audioModeOneIcon.hidden = s.audioMode !== "one";
      d.audioModeListIcon.hidden = s.audioMode !== "list";
      d.audioModeShuffleIcon.hidden = s.audioMode !== "shuffle";
      d.audioModeToggle.title = d.audioModeToggle.ariaLabel = t(modeKey);
      d.audioSeek.ariaLabel = t("seek");
      d.audioVolume.ariaLabel = t("volume");
      d.audioSeek.max = String(duration);
      if (!audioSeeking) d.audioSeek.value = String(Math.min(d.audio.currentTime || 0, duration));
      d.audioVolume.value = String(muted ? 0 : d.audio.volume);
      d.audioTime.value = `${formatTime(d.audio.currentTime)} / ${formatTime(duration)}`;
      setRangeFill(d.audioSeek, duration ? (Number(d.audioSeek.value) / duration) * 100 : 0);
      setRangeFill(d.audioVolume, Number(d.audioVolume.value) * 100);
    }

    function togglePlay() {
      if (d.video.paused) d.video.play().catch(() => undefined);
      else d.video.pause();
    }

    function toggleAudioPlay() {
      if (d.audio.paused) d.audio.play().catch(() => undefined);
      else d.audio.pause();
    }

    function cycleAudioMode() {
      s.audioMode = s.audioMode === "one" ? "list" : s.audioMode === "list" ? "shuffle" : "one";
      updateAudioControls();
    }

    async function continueAudio() {
      if (s.audioMode === "one") {
        d.audio.currentTime = 0;
        await d.audio.play().catch(() => undefined);
        return;
      }

      const tracks = s.audioQueue;
      const alternatives = tracks.filter((item) => item.path !== s.current?.path);
      if (!alternatives.length) return;
      let next: MediaItem;
      if (s.audioMode === "shuffle") {
        next = alternatives[Math.floor(Math.random() * alternatives.length)];
      } else {
        const current = tracks.findIndex((item) => item.path === s.current?.path);
        next = tracks[(current + 1 + tracks.length) % tracks.length];
      }
      await openItem(next.path);
    }

    function setLyricsState(key: "lyricsLoading" | "lyricsEmpty" | "lyricsFailed") {
      d.lyricsPanel.hidden = false;
      d.lyricsList.classList.remove("is-intro");
      d.lyricsList.innerHTML = `<div class="lyrics-state">${esc(t(key))}</div>`;
    }

    function resetLyrics() {
      window.clearTimeout(s.lyricScrollTimer);
      s.lyricToken += 1;
      s.lyrics = [];
      s.lyricIndex = -1;
      s.lyricManual = false;
      d.lyricsList.classList.remove("is-intro");
      d.lyricsList.replaceChildren();
      d.lyricsPanel.hidden = true;
    }

    function centerLyric(line: HTMLElement, behavior: ScrollBehavior) {
      const listBox = d.lyricsList.getBoundingClientRect();
      const lineBox = line.getBoundingClientRect();
      const top = d.lyricsList.scrollTop + lineBox.top - listBox.top - (listBox.height - lineBox.height) / 2;
      d.lyricsList.scrollTo({ top: Math.max(0, top), behavior });
    }

    function pauseLyricFollow() {
      s.lyricManual = true;
      window.clearTimeout(s.lyricScrollTimer);
      s.lyricScrollTimer = window.setTimeout(() => {
        s.lyricManual = false;
        syncLyrics(true);
      }, 3000);
    }

    function syncLyrics(force = false) {
      if (!s.lyrics.length) return;
      const now = d.audio.currentTime + 0.05;
      let low = 0;
      let high = s.lyrics.length - 1;
      let index = -1;
      while (low <= high) {
        const middle = (low + high) >> 1;
        if (s.lyrics[middle].at <= now) {
          index = middle;
          low = middle + 1;
        } else {
          high = middle - 1;
        }
      }
      d.lyricsList.classList.toggle("is-intro", index < Math.min(3, s.lyrics.length));
      if (!force && index === s.lyricIndex) return;

      const previous = d.lyricsList.querySelector<HTMLElement>(".is-active");
      previous?.classList.remove("is-active");
      previous?.removeAttribute("aria-current");
      s.lyricIndex = index;
      if (index < 0) {
        d.lyricsList.scrollTo({ top: 0, behavior: force ? "auto" : "smooth" });
        return;
      }

      const line = d.lyricsList.querySelector<HTMLElement>(`[data-lyric="${index}"]`);
      if (!line) return;
      line.classList.add("is-active");
      line.setAttribute("aria-current", "true");
      if (force || !s.lyricManual) centerLyric(line, force ? "auto" : "smooth");
    }

    function renderLyrics(cues: LyricCue[]) {
      s.lyrics = cues;
      s.lyricIndex = -1;
      if (!cues.length) return setLyricsState("lyricsEmpty");
      d.lyricsPanel.hidden = false;
      d.lyricsList.classList.add("is-intro");
      d.lyricsList.innerHTML = cues.map((cue, index) => {
        const top = cue.top || cue.bottom || "";
        const bottom = cue.top ? cue.bottom : undefined;
        return `
          <button class="lyric-line" type="button" data-lyric="${index}" data-at="${cue.at}">
            <span class="lyric-top">${esc(top)}</span>
            ${bottom ? `<span class="lyric-bottom">${esc(bottom)}</span>` : ""}
          </button>
        `;
      }).join("");
      syncLyrics(true);
    }

    async function loadLyrics(item: MediaItem) {
      const token = ++s.lyricToken;
      setLyricsState("lyricsLoading");
      const fetchTrack = async (slot: 1 | 2) => {
        const response = await fetch(`/api/public/lyric?path=${encodeURIComponent(item.path)}&n=${slot}`);
        if (!response.ok) throw new Error("Lyrics request failed.");
        return response.text();
      };
      const [primary, other] = await Promise.all([
        item.lrc ? fetchTrack(1).catch(() => null) : Promise.resolve(null),
        item.lrc2 ? fetchTrack(2).catch(() => null) : Promise.resolve(null)
      ]);
      if (token !== s.lyricToken) return;
      if (primary === null && other === null) return setLyricsState("lyricsFailed");
      renderLyrics(primary && other ? buildLyrics(primary, other) : buildLyrics(primary || other || ""));
    }

    type WebkitVideo = HTMLVideoElement & {
      webkitEnterFullscreen?: () => void;
      webkitExitFullscreen?: () => void;
      webkitDisplayingFullscreen?: boolean;
    };
    type WebkitDocument = Document & { webkitFullscreenElement?: Element | null; webkitExitFullscreen?: () => void };
    const webkitVideo = d.video as WebkitVideo;
    const webkitDocument = document as WebkitDocument;
    function isVideoFullscreen() {
      return document.fullscreenElement === d.videoFrame || webkitDocument.webkitFullscreenElement === d.videoFrame || Boolean(webkitVideo.webkitDisplayingFullscreen);
    }

    async function toggleFullscreen() {
      if (document.fullscreenElement || webkitDocument.webkitFullscreenElement || webkitVideo.webkitDisplayingFullscreen) {
        if (document.fullscreenElement && document.exitFullscreen) await document.exitFullscreen();
        else webkitDocument.webkitExitFullscreen?.();
      } else {
        try {
          if (d.videoFrame.requestFullscreen) await d.videoFrame.requestFullscreen();
          else throw new Error("Fullscreen API unavailable");
        } catch {
          // iPadOS Safari exposes fullscreen on the video element rather than its custom container.
          if (webkitVideo.webkitEnterFullscreen) webkitVideo.webkitEnterFullscreen();
          else if ((d.videoFrame as HTMLElement & { webkitRequestFullscreen?: () => Promise<void> }).webkitRequestFullscreen) await (d.videoFrame as HTMLElement & { webkitRequestFullscreen: () => Promise<void> }).webkitRequestFullscreen();
          else throw new Error("Fullscreen is unavailable on this browser");
        }
      }
      if (!webkitVideo.webkitDisplayingFullscreen) d.videoFrame.focus({ preventScroll: true });
    }

    function applyLanguage() {
      document.documentElement.lang = s.lang === "zh" ? "zh-CN" : s.lang === "ja" ? "ja" : "en";
      document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
        const key = el.dataset.i18n as keyof (typeof c)["en"];
        if (key && c[s.lang][key]) el.textContent = t(key);
      });
      document.querySelectorAll<HTMLElement>("[data-i18n-title]").forEach((el) => {
        const key = el.dataset.i18nTitle as keyof (typeof c)["en"];
        if (key && c[s.lang][key]) el.title = t(key);
      });
      document.querySelectorAll<HTMLInputElement>("[data-i18n-placeholder]").forEach((el) => {
        const key = el.dataset.i18nPlaceholder as keyof (typeof c)["en"];
        if (key && c[s.lang][key]) el.placeholder = t(key);
      });
      updateVideoControls();
      updateAudioControls();
      setLibraryOpen(d.app.classList.contains("is-library-open"));
      render();
      renderCurrent();
      renderStats();
    }

    function render() {
      d.path.textContent = displayPath(s.path);
      d.parent.disabled = s.path === "/root";
      const items = s.items;
      d.count.textContent = `${items.length} ${items.length === 1 ? t("item") : t("items")}`;
      if (!items.length) {
        d.list.innerHTML = `<div class="list-state">${esc(t("empty"))}</div>`;
        return;
      }
      d.list.innerHTML = items.map((item) => `
        <button class="file-row${s.current?.path === item.path ? " is-active" : ""}" type="button" data-path="${esc(item.path)}" data-dir="${item.isDir ? "1" : "0"}">
          <span class="file-icon file-icon-${esc(type(item))}">${icon(item)}</span>
          <span class="file-copy">
            <strong>${esc(item.name)}</strong>
            <small>${esc(s.query ? displayPath(item.path) : item.artist || t(type(item) as "folder" | "video" | "audio" | "image"))}</small>
          </span>
        </button>
      `).join("");
    }

    function renderCurrent() {
      updateMediaNavigation();
      if (!s.current) return;
      d.kind.textContent = t(s.current.kind || "video");
      d.title.textContent = s.current.name;
      d.mediaPath.textContent = s.current.artist || displayPath(s.current.path);
      d.subtitle.hidden = !s.current.sub;
      d.lyricsBadge.hidden = !s.current.lrc && !s.current.lrc2;
    }

    async function load(path = s.path, query = d.search.value.trim(), navigation: NavigationMode = "none") {
      if (navigation !== "none") {
        routeRequest += 1;
        itemRequest += 1;
        cancelItemLoadingFeedback();
      }
      const route = routeRequest;
      const request = ++listRequest;
      setStatus(d.libraryStatus, t("loading"));
      let data: any;
      try {
        const response = await fetch("/api/public/list", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ path, q: query })
        });
        data = await response.json();
      } catch (error) {
        if (request !== listRequest || route !== routeRequest) {
          if (request === listRequest) setStatus(d.libraryStatus);
          return false;
        }
        throw error;
      }
      if (request !== listRequest || route !== routeRequest) {
        if (request === listRequest) setStatus(d.libraryStatus);
        return false;
      }
      if (!data.ok) throw new Error(data.details || data.error || t("loadFailed"));
      s.path = data.path || "/root";
      s.items = data.items || [];
      s.query = data.query || "";
      setStatus(d.libraryStatus);
      render();
      updateVisitorUrl(s.path, navigation);
      if (navigation !== "none") trackVisitor(s.path === "/root" ? "visit" : "directory", s.path);
      return true;
    }

    function clearSearch() {
      window.clearTimeout(searchTimer);
      d.search.value = "";
      s.query = "";
    }

    async function clearMedia() {
      saveProgress(true);
      if (s.ass) {
        await s.ass.destroy().catch(() => undefined);
        s.ass = null;
      }
      d.video.pause();
      d.audio.pause();
      d.video.removeAttribute("src");
      d.audio.removeAttribute("src");
      d.image.removeAttribute("src");
      d.videoFrame.hidden = true;
      d.videoFrame.classList.remove("controls-hidden");
      window.clearTimeout(controlTimer);
      d.imageFrame.hidden = true;
      d.audioFrame.hidden = true;
      d.audioFrame.classList.remove("is-playing");
      d.audioSeek.value = "0";
      d.audioSeek.max = "0";
      d.audioTime.value = "00:00 / 00:00";
      setRangeFill(d.audioSeek, 0);
      delete d.stage.dataset.mode;
      resetLyrics();
      d.empty.hidden = true;
    }

    async function requestItem(path: string, allowMissing = false): Promise<ItemPayload | null> {
      const response = await fetch("/api/public/item", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ path })
      });
      const data = (await response.json()) as ItemPayload & { ok?: boolean; error?: string; details?: string };
      if (allowMissing && response.status === 404) return null;
      if (!response.ok || !data.ok) throw new Error(data.details || data.error || t("itemFailed"));
      return data;
    }

    async function openItem(path: string, navigation: NavigationMode = "push", prefetched?: ItemPayload) {
      if (navigation !== "none") {
        routeRequest += 1;
        setStatus(d.libraryStatus);
      }
      const route = routeRequest;
      const request = ++itemRequest;
      setStatus(d.playerStatus, t("loading"));
      d.stage.dataset.signal = "transfer";
      let data: ItemPayload | null;
      try {
        data = prefetched || await requestItem(path);
      } catch (error) {
        if (request !== itemRequest || route !== routeRequest) return;
        throw error;
      }
      if (request !== itemRequest || route !== routeRequest || !data) return;
      const item: MediaItem = data.item;
      const audioQueue = s.items.filter((entry) => !entry.isDir && entry.kind === "audio");
      const videoQueue = s.items.filter((entry) => !entry.isDir && entry.kind === "video");
      await clearMedia();
      if (request !== itemRequest || route !== routeRequest) return;
      s.current = item;
      resetStatSession(data.stat || { plays: 0, completions: 0, rate: 0 });
      if (item.kind === "audio" && !s.audioQueue.some((entry) => entry.path === item.path)) s.audioQueue = audioQueue;
      if (item.kind === "video" && !s.videoQueue.some((entry) => entry.path === item.path)) s.videoQueue = videoQueue;
      renderCurrent();
      render();
      updateVisitorUrl(item.path, navigation);
      trackVisitor("media", item.path);

      if (item.kind === "image") {
        d.stage.dataset.mode = "image";
        d.imageFrame.hidden = false;
        d.image.src = item.url || "";
        d.image.alt = item.name;
        recordStat("play");
      } else if (item.kind === "audio") {
        d.stage.dataset.mode = "audio";
        d.audioFrame.hidden = false;
        d.audioPoster.src = item.poster || "/poster.svg";
        d.audioPoster.alt = item.name;
        d.audioTitle.textContent = item.name;
        d.audioPath.textContent = item.artist || displayPath(item.path);
        d.audio.src = item.url || "";
        d.audio.load();
        updateAudioControls();
        if (item.lrc || item.lrc2) loadLyrics(item).catch(() => setLyricsState("lyricsFailed"));
        d.audio.play().catch(() => undefined);
      } else {
        d.stage.dataset.mode = "video";
        d.videoFrame.hidden = false;
        d.video.poster = item.poster || "/poster.svg";
        d.video.src = item.url || "";
        d.video.load();
        updateVideoControls();
        showControls();
        if (item.sub) {
          try {
            const subUrl = `/api/public/sub?path=${encodeURIComponent(item.path)}`;
            const response = await fetch(subUrl);
            if (!response.ok) throw new Error("Subtitle request failed.");
            const rawSubtitle = await response.text();
            const fontPromise = subtitleFontUrls(rawSubtitle);
            const subContent = normalizeAssFonts(rawSubtitle, "Noto Sans SC");
            const ass = new JASSUB({
              video: d.video,
              subContent
            });
            s.ass = ass;
            d.videoFrame.dataset.subtitleReady = "0";
            Promise.all([ass.ready, fontPromise]).then(async ([, font]) => {
              if (s.ass !== ass) return;
              await ass.renderer.addFonts(font.fonts);
              ass.renderer.setDefaultFont(font.defaultFont);
              await ass.resize(true);
              d.videoFrame.dataset.subtitleReady = "1";
            }).catch(() => {
              if (s.ass === ass) setStatus(d.playerStatus, t("subFailed"), "error");
            });
          } catch {
            setStatus(d.playerStatus, t("subFailed"), "error");
          }
        }
        d.video.play().catch(() => undefined);
      }
      if (!d.playerStatus.dataset.tone) setStatus(d.playerStatus, t("playing"));
    }

    d.list.addEventListener("click", (event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>("[data-path]");
      if (!row?.dataset.path) return;
      if (row.dataset.dir !== "1") setLibraryOpen(false);
      if (row.dataset.dir === "1") clearSearch();
      const action = row.dataset.dir === "1" ? load(row.dataset.path, "", "push") : openItem(row.dataset.path, "push");
      action.catch((error) => {
        if (row.dataset.dir !== "1") d.stage.dataset.signal = "interrupted";
        setStatus(row.dataset.dir === "1" ? d.libraryStatus : d.playerStatus, error.message, "error");
      });
    });

    d.parent.addEventListener("click", () => {
      const parent = s.path.split("/").filter(Boolean).slice(0, -1).join("/");
      clearSearch();
      load(parent ? `/${parent}` : "/root", "", "push").catch((error) => setStatus(d.libraryStatus, error.message, "error"));
    });
    d.refresh.addEventListener("click", () => load().catch((error) => setStatus(d.libraryStatus, error.message, "error")));
    d.search.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      const query = d.search.value.trim();
      searchTimer = window.setTimeout(() => {
        load(s.path, query).catch((error) => setStatus(d.libraryStatus, error.message, "error"));
      }, 220);
    });
    d.libraryToggle.addEventListener("click", () => setLibraryOpen(!d.app.classList.contains("is-library-open")));
    d.libraryScrim.addEventListener("click", () => setLibraryOpen(false));
    let librarySwipeStart: { x: number; y: number } | null = null;
    document.addEventListener("pointerdown", (event) => {
      if (!isMobileLibraryAvailable()) return;
      if (event.clientX <= 24 || d.app.classList.contains("is-library-open")) {
        librarySwipeStart = { x: event.clientX, y: event.clientY };
      }
    });
    document.addEventListener("pointerup", (event) => {
      if (!librarySwipeStart) return;
      const start = librarySwipeStart;
      librarySwipeStart = null;
      const deltaX = event.clientX - start.x;
      const deltaY = event.clientY - start.y;
      if (Math.abs(deltaX) < 60 || Math.abs(deltaX) < Math.abs(deltaY) * 1.25) return;
      if (deltaX > 0 && start.x <= 24) setLibraryOpen(true);
      if (deltaX < 0 && d.app.classList.contains("is-library-open")) setLibraryOpen(false);
    });
    document.addEventListener("pointercancel", () => {
      librarySwipeStart = null;
    });
    libraryMedia.addEventListener("change", () => setLibraryOpen(d.app.classList.contains("is-library-open")));
    touchMedia.addEventListener("change", () => setLibraryOpen(d.app.classList.contains("is-library-open")));
    d.audio.addEventListener("timeupdate", () => {
      syncLyrics();
      updateAudioControls();
      saveProgress();
    });
    d.audio.addEventListener("seeked", () => syncLyrics(true));
    ["play", "pause", "durationchange", "loadedmetadata", "volumechange"].forEach((event) => {
      d.audio.addEventListener(event, updateAudioControls);
    });
    d.audio.addEventListener("play", () => {
      delete d.stage.dataset.signal;
      recordPlay();
    });
    d.audio.addEventListener("loadedmetadata", () => restoreProgress(d.audio));
    d.audio.addEventListener("pause", () => saveProgress(true));
    ["waiting", "stalled"].forEach((event) => {
      d.audio.addEventListener(event, () => {
        d.stage.dataset.signal = "unstable";
        setStatus(d.playerStatus, t("buffering"));
      });
    });
    ["canplay", "playing"].forEach((event) => {
      d.audio.addEventListener(event, () => {
        delete d.stage.dataset.signal;
        if (s.current?.kind === "audio") setStatus(d.playerStatus, t("playing"));
      });
    });
    d.audio.addEventListener("error", () => {
      d.stage.dataset.signal = "interrupted";
    });
    d.image.addEventListener("load", () => {
      delete d.stage.dataset.signal;
    });
    d.image.addEventListener("error", () => {
      d.stage.dataset.signal = "interrupted";
    });
    d.audio.addEventListener("ended", async () => {
      saveProgress(true, true);
      updateAudioControls();
      await recordStat("complete");
      continueAudio().catch((error) => setStatus(d.playerStatus, error.message, "error"));
    });
    d.audioPlayToggle.addEventListener("click", toggleAudioPlay);
    d.audioPrevious.addEventListener("click", () => playAdjacent("audio", -1).catch((error) => setStatus(d.playerStatus, error.message, "error")));
    d.audioNext.addEventListener("click", () => playAdjacent("audio", 1).catch((error) => setStatus(d.playerStatus, error.message, "error")));
    d.audioModeToggle.addEventListener("click", cycleAudioMode);
    d.audioMuteToggle.addEventListener("click", () => {
      d.audio.muted = !d.audio.muted;
      if (!d.audio.muted && d.audio.volume === 0) d.audio.volume = 1;
    });
    d.audioSeek.addEventListener("pointerdown", () => {
      audioSeeking = true;
    });
    d.audioSeek.addEventListener("input", () => {
      d.audio.currentTime = Number(d.audioSeek.value);
      updateAudioControls();
      syncLyrics(true);
    });
    d.audioSeek.addEventListener("change", () => {
      audioSeeking = false;
      updateAudioControls();
    });
    d.audioVolume.addEventListener("input", () => {
      d.audio.muted = false;
      d.audio.volume = Number(d.audioVolume.value);
    });
    d.audioPoster.addEventListener("error", () => {
      if (!d.audioPoster.src.endsWith("/poster.svg")) d.audioPoster.src = "/poster.svg";
    });
    d.lyricsList.addEventListener("wheel", pauseLyricFollow, { passive: true });
    d.lyricsList.addEventListener("touchstart", pauseLyricFollow, { passive: true });
    d.lyricsList.addEventListener("click", (event) => {
      const line = (event.target as HTMLElement).closest<HTMLElement>("[data-at]");
      if (!line?.dataset.at) return;
      window.clearTimeout(s.lyricScrollTimer);
      s.lyricManual = false;
      d.audio.currentTime = Number(line.dataset.at);
      syncLyrics(true);
    });
    d.playToggle.addEventListener("click", togglePlay);
    d.videoPrevious.addEventListener("click", () => playAdjacent("video", -1).catch((error) => setStatus(d.playerStatus, error.message, "error")));
    d.videoNext.addEventListener("click", () => playAdjacent("video", 1).catch((error) => setStatus(d.playerStatus, error.message, "error")));
    d.speedToggle.addEventListener("click", cycleVideoSpeed);
    d.muteToggle.addEventListener("click", () => {
      d.video.muted = !d.video.muted;
      if (!d.video.muted && d.video.volume === 0) d.video.volume = 1;
    });
    d.fullscreenToggle.addEventListener("click", () => toggleFullscreen().catch(() => undefined));
    d.videoFrame.addEventListener("click", (event) => {
      if (d.videoControls.contains(event.target as Node)) return;
      if (suppressVideoClick) {
        event.preventDefault();
        return;
      }
      window.clearTimeout(videoClickTimer);
      const rect = d.videoFrame.getBoundingClientRect();
      const inLeftFifth = event.clientX - rect.left <= rect.width / 5;
      if (event.detail >= 3 && inLeftFifth) {
        d.video.currentTime = Math.max(0, d.video.currentTime - 5);
        updateVideoControls();
        showControls();
        suppressVideoClick = true;
        window.setTimeout(() => {
          suppressVideoClick = false;
        }, 320);
        return;
      }
      videoClickTimer = window.setTimeout(() => {
        if (event.detail >= 2) {
          togglePlay();
          showControls();
        } else {
          toggleVideoControls();
        }
      }, 280);
    });
    d.videoFrame.addEventListener("dblclick", (event) => {
      if (d.videoControls.contains(event.target as Node) || suppressVideoClick) return;
      event.preventDefault();
    });
    d.videoFrame.addEventListener("pointerdown", (event) => {
      d.videoFrame.focus({ preventScroll: true });
      beginVideoHold(event);
    });
    d.videoFrame.addEventListener("pointermove", (event) => {
      moveVideoHold(event);
      if (!d.videoFrame.classList.contains("controls-hidden") && !videoHoldMode) showControls();
    });
    d.videoFrame.addEventListener("pointerleave", () => {
      stopVideoHold();
      scheduleControls();
    });
    d.videoFrame.addEventListener("pointercancel", stopVideoHold);
    d.videoFrame.addEventListener("contextmenu", (event) => {
      if (!d.videoControls.contains(event.target as Node)) event.preventDefault();
    });
    d.videoControls.addEventListener("pointerenter", () => showControls());
    d.videoControls.addEventListener("pointerleave", () => scheduleControls());
    d.videoControls.addEventListener("click", () => showControls());
    d.videoControls.addEventListener("focusin", () => showControls(!isVideoFullscreen()));
    d.videoControls.addEventListener("focusout", () => showControls());
    d.seek.addEventListener("pointerdown", () => {
      seeking = true;
      showControls(true);
    });
    d.seek.addEventListener("input", () => {
      d.video.currentTime = Number(d.seek.value);
      updateVideoControls();
    });
    window.addEventListener("pointerup", () => {
      stopVideoHold();
      if (seeking) {
        seeking = false;
        scheduleControls();
      }
      if (audioSeeking) {
        audioSeeking = false;
        updateAudioControls();
      }
    });
    d.volume.addEventListener("input", () => {
      d.video.muted = false;
      d.video.volume = Number(d.volume.value);
    });
    ["play", "pause", "ended", "timeupdate", "durationchange", "loadedmetadata", "volumechange", "ratechange"].forEach((event) => {
      d.video.addEventListener(event, () => {
        updateVideoControls();
        if (event === "timeupdate") saveProgress();
        if (event === "play") {
          scheduleControls();
          recordPlay();
        }
        if (event === "ended") {
          saveProgress(true, true);
          recordStat("complete");
        }
        if (event === "pause") saveProgress(true);
        if (event === "pause" || event === "ended") showControls();
      });
    });
    d.video.addEventListener("loadedmetadata", () => restoreProgress(d.video));
    ["waiting", "stalled"].forEach((event) => {
      d.video.addEventListener(event, () => {
        d.stage.dataset.signal = "unstable";
        setStatus(d.playerStatus, t("buffering"));
      });
    });
    ["canplay", "playing"].forEach((event) => {
      d.video.addEventListener(event, () => {
        delete d.stage.dataset.signal;
        if (s.current?.kind === "video") setStatus(d.playerStatus, t("playing"));
      });
    });
    d.video.addEventListener("error", () => {
      d.stage.dataset.signal = "interrupted";
    });
    document.addEventListener("fullscreenchange", () => {
      updateVideoControls();
      showControls();
      s.ass?.resize(true).catch(() => undefined);
    });
    ["webkitbeginfullscreen", "webkitendfullscreen"].forEach((event) => {
      d.video.addEventListener(event, () => {
        updateVideoControls();
        s.ass?.resize(true).catch(() => undefined);
      });
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && d.app.classList.contains("is-library-open")) {
        setLibraryOpen(false);
        return;
      }
      if (d.videoFrame.hidden) return;
      const active = document.activeElement;
      const controlsPlayer = isVideoFullscreen() || active === d.videoFrame || (active instanceof Node && d.videoFrame.contains(active));
      if (!controlsPlayer || active instanceof HTMLInputElement) return;
      const key = event.key.toLowerCase();
      if (key === " " || key === "k") togglePlay();
      else if (key === "f") toggleFullscreen().catch(() => undefined);
      else if (key === "m") d.video.muted = !d.video.muted;
      else if (key === "arrowleft") d.video.currentTime = Math.max(0, d.video.currentTime - 5);
      else if (key === "arrowright") d.video.currentTime = Math.min(d.video.duration || Infinity, d.video.currentTime + 5);
      else return;
      event.preventDefault();
      showControls();
    });
    d.language.addEventListener("change", () => {
      s.lang = d.language.value as Lang;
      localStorage.setItem("rp_l", s.lang);
      cookie.set("rp_l", s.lang);
      applyLanguage();
    });

    async function restoreVisitorRoute(canonicalize = false) {
      const request = ++routeRequest;
      itemRequest += 1;
      setStatus(d.libraryStatus);
      cancelItemLoadingFeedback();
      clearSearch();

      const requestedPath = pseudoPathFromVisitorUrl(location.pathname);
      const path = requestedPath || "/root";
      if (!requestedPath || path === "/root") {
        const rootLoaded = await load("/root", "", "none");
        if (!rootLoaded || request !== routeRequest) return;
        updateVisitorUrl("/root", !requestedPath || canonicalize ? "replace" : "none");
        return;
      }

      const folderLoaded = await load(path, "", "none");
      if (!folderLoaded || request !== routeRequest) return;
      if (s.items.length) {
        updateVisitorUrl(path, canonicalize ? "replace" : "none");
        return;
      }

      let item: ItemPayload | null;
      try {
        item = await requestItem(path, true);
      } catch (error) {
        if (request !== routeRequest) return;
        throw error;
      }
      if (request !== routeRequest) return;
      if (item) {
        const parentLoaded = await load(parentPseudoPath(path), "", "none");
        if (!parentLoaded || request !== routeRequest) return;
        await openItem(path, "none", item);
      }
      if (request !== routeRequest) return;
      updateVisitorUrl(path, canonicalize ? "replace" : "none");
    }

    const saved = cookie.get("rp_l");
    if (saved === "zh" || saved === "ja" || saved === "en") s.lang = saved;
    d.language.value = s.lang;
    applyLanguage();
    window.addEventListener("pagehide", () => saveProgress(true));
    window.addEventListener("popstate", () => {
      restoreVisitorRoute().catch((error) => setStatus(d.libraryStatus, error.message, "error"));
    });
    trackVisitor("visit", pseudoPathFromVisitorUrl(location.pathname) || "/root");
    restoreVisitorRoute(true).catch((error) => setStatus(d.libraryStatus, error.message, "error"));
  </script>
    </>
  )}
</SiteShell>

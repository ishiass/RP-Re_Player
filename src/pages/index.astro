    const videoEvents = ["play", "pause", "ended", "timeupdate", "seeked", "durationchange", "loadedmetadata", "volumechange", "ratechange", "waiting", "stalled", "canplay", "playing", "error"];
    const boundVideoMedia = new WeakSet<EventTarget>();

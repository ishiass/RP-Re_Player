---
import {
  ArrowLeft,
  Captions,
  FastForward,
  FileImage,
  Film,
  Folder,
  FolderUp,
  Languages,
  Music2,
  Maximize,
  Minimize,
  Pause,
  Play,
  RefreshCw,
  Repeat,
  Repeat1,
  Rewind,
  Search,
  Shuffle,
  SkipBack,
  SkipForward,
  Volume2,
  VolumeX
} from "@lucide/astro";
import SiteShell from "../layouts/SiteShell.astro";
import { getEnv } from "@lib/cloudflare";
import { getVisitorTheme } from "@lib/theme";

const isEntry = Astro.url.pathname === "/Re";
if (Astro.url.pathname === "/") return Astro.redirect("/Re", 302);

const env = await getEnv(Astro);
const visitorTheme = await getVisitorTheme(env);
const externalUrl = (input?: string) => {
  const value = input?.trim();
  if (!value) return "";
  try {
    const url = new URL(value);
    return url.protocol === "http:" || url.protocol === "https:" ? url.href : "";
  } catch {
    return "";
  }
};
const introSource = externalUrl(env.A);
const introAudioSource = externalUrl(env.C);
const introIsVideo = /\.(?:mp4|webm|ogv|ogg|m4v|mov)(?:$|[?#])/i.test(introSource);
const introMaxSeconds = (() => {
  const value = Number(env.B ?? "4.2");
  return Number.isFinite(value) && value > 0 ? Math.min(value, 86400) : 4.2;
})();
---

<SiteShell title="Re-Player">
  {
    isEntry && introSource && (
      <div id="externalIntro" class="external-intro" data-max-seconds={introMaxSeconds || undefined}>
        {introIsVideo ? (
          <video class="external-intro-media" src={introSource} autoplay muted={Boolean(introAudioSource)} playsinline preload="auto" />
        ) : (
          <img class="external-intro-media" src={introSource} alt="" />
        )}
        {introAudioSource && <audio class="external-intro-audio" src={introAudioSource} autoplay preload="auto" />}
      </div>
    )
  }
  <script is:inline>
    (() => {
      const intro = document.querySelector("#externalIntro");
      const visual = intro?.querySelector(".external-intro-media");
      const music = intro?.querySelector(".external-intro-audio");
      if (!intro || !visual) {
        if (location.pathname === "/Re") location.replace(/Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent) ? "/Local" : "/Loading");
        return;
      }
      const maxSeconds = Number(intro.dataset.maxSeconds) || 0;
      const playable = [visual instanceof HTMLVideoElement ? visual : null, music instanceof HTMLAudioElement ? music : null].filter(Boolean);
      let closed = false;
      let starting = false;
      let timer = 0;
      const stopPlayback = () => {
        playable.forEach((item) => {
          item.pause();
          item.removeAttribute("src");
          item.load();
        });
      };
      const close = () => {
        if (closed) return;
        closed = true;
        if (timer) window.clearTimeout(timer);
        intro.classList.add("is-leaving");
        window.setTimeout(() => {
          stopPlayback();
          intro.remove();
          location.replace(/Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent) ? "/Local" : "/Loading");
        }, 260);
      };
      const schedule = (seconds) => {
        if (!(seconds > 0) || timer) return;
        timer = window.setTimeout(close, seconds * 1000);
      };
      const playMusic = async () => {
        if (!(music instanceof HTMLAudioElement)) return;
        music.removeAttribute("muted");
        music.muted = false;
        music.volume = 1;
        try {
          await music.play();
        } catch {
          music.pause();
          music.removeAttribute("src");
          music.load();
        }
      };
      const playVideo = async () => {
        if (!(visual instanceof HTMLVideoElement)) return;
        const useExternalAudio = music instanceof HTMLAudioElement;
        visual.defaultMuted = useExternalAudio;
        visual.muted = useExternalAudio;
        if (useExternalAudio) visual.setAttribute("muted", "");
        else visual.removeAttribute("muted");
        try {
          await visual.play();
        } catch {
          if (useExternalAudio) return;
          visual.defaultMuted = true;
          visual.muted = true;
          visual.setAttribute("muted", "");
          await visual.play().catch(close);
        }
      };
      const startPlayback = async () => {
        if (starting || closed) return;
        starting = true;
        await Promise.allSettled([playVideo(), playMusic()]);
        starting = false;
        schedule(maxSeconds || 4.2);
      };
      intro.addEventListener("pointerdown", close, { once: true });
      if (visual instanceof HTMLVideoElement) {
        visual.addEventListener("ended", close, { once: true });
        visual.addEventListener("error", close, { once: true });
        startPlayback();
      } else if (visual instanceof HTMLImageElement) {
        const show = () => playable.length ? startPlayback() : schedule(maxSeconds || 4.2);
        visual.addEventListener("error", close, { once: true });
        if (music instanceof HTMLAudioElement) music.addEventListener("ended", close, { once: true });
        if (visual.complete && visual.naturalWidth) show();
        else visual.addEventListener("load", show, { once: true });
      }
    })();
  </script>

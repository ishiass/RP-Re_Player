    window.addEventListener("popstate", () => {
      restoreVisitorRoute().catch((error) => setStatus(d.libraryStatus, error.message, "error"));
    });
    trackVisitor("visit", pseudoPathFromVisitorUrl(location.pathname) || "/root");
    restoreVisitorRoute(true).catch((error) => setStatus(d.libraryStatus, error.message, "error"));

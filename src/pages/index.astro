    d.videoControls.addEventListener("pointerleave", () => scheduleControls());
    d.videoControls.addEventListener("click", () => showControls());
    d.videoControls.addEventListener("focusin", () => showControls(!isVideoFullscreen()));
    d.videoControls.addEventListener("focusout", () => showControls());
    d.seek.addEventListener("pointerdown", () => {

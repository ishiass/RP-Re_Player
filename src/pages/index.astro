    let progressStamp = 0;
    let lastProgressPath = "";
    let lastProgressTime = -1;
    const cookie = {
      get(name: string) {
        const value = document.cookie.split("; ").find((part) => part.startsWith(`${name}=`))?.slice(name.length + 1);
        if (!value) return "";
        try {
          return decodeURIComponent(value);
        } catch {
          return "";
        }
      },
      set(name: string, value: string, age = 31536000) {
        document.cookie = `${name}=${encodeURIComponent(value)}; Path=/; Max-Age=${age}; SameSite=Lax`;
      }
    };
    function parseProgress(raw: string): SavedProgress | null {
      try {
        const value = JSON.parse(raw) as SavedProgress;
        return typeof value?.p === "string" && Number.isFinite(value?.t) ? value : null;
      } catch {
        return null;
      }
    }

    function progressKey(path: string) {
      let a = 2166136261;
      let b = 5381;
      for (let i = 0; i < path.length; i += 1) {
        const code = path.charCodeAt(i);
        a = Math.imul(a ^ code, 16777619);
        b = Math.imul(b, 33) ^ code;
      }
      return `rp_p_${(a >>> 0).toString(36)}_${(b >>> 0).toString(36)}`;
    }

    function readProgress(path: string) {
      const current = parseProgress(cookie.get(progressKey(path)));
      if (current?.p === path) return current;
      const legacy = parseProgress(cookie.get("rp_p"));
      if (legacy?.p !== path) return null;
      cookie.set(progressKey(path), JSON.stringify(legacy));
      cookie.set("rp_p", "", 0);
      return legacy;
    }

    type VideoMedia = HTMLVideoElement | MoviElement;

    function activeVideo(): VideoMedia {
      if (s.videoBackend === "movi") return d.movi;
      if (s.videoBackend === "vplayer" && s.vplayerVideo) return s.vplayerVideo;
      return d.video;
    }

    function ownsVideoControls() {
      return s.moviActive || s.videoBackend === "vplayer";
    }

    function activeMedia(): VideoMedia | HTMLAudioElement | null {
      if (s.current?.kind === "video") return activeVideo();
      if (s.current?.kind === "audio") return d.audio;
      return null;
    }

    function saveProgress(force = false, complete = false) {
      const media = activeMedia();
      if (!media || !s.current || !Number.isFinite(media.currentTime)) return;
      const now = Date.now();
      const currentTime = Math.max(0, media.currentTime);
      if (!force && now - progressStamp < 1000) return;
      if (!force && lastProgressPath === s.current.path && Math.abs(currentTime - lastProgressTime) < 0.01) return;
      const duration = Number.isFinite(media.duration) && media.duration > 0 ? media.duration : undefined;
      const ended = Boolean(duration && (complete || media.ended || duration - media.currentTime <= 3));
      if (!ended && media.currentTime <= 0) return;
      const value: SavedProgress = {
        p: s.current.path,
        t: Math.round((ended && duration ? duration : currentTime) * 100) / 100
      };
      if (duration) value.d = Math.round(duration * 100) / 100;
      if (ended) value.e = 1;
      cookie.set(progressKey(s.current.path), JSON.stringify(value));
      progressStamp = now;
      lastProgressPath = s.current.path;
      lastProgressTime = currentTime;
      if (value.t > 0) markLibraryItemPlayed(s.current.path);
    }

    function restoreProgress(media: VideoMedia | HTMLAudioElement) {
      if (!s.current) return;
      const saved = readProgress(s.current.path);
      if (!saved || saved.t <= 0) return;
      const duration = Number.isFinite(media.duration) && media.duration > 0 ? media.duration : undefined;
      media.currentTime = duration ? (saved.e ? duration : Math.min(saved.t, duration)) : saved.t;
    }
    let statCompleted = false;
    let statTask: Promise<void> = Promise.resolve();

    const VIDEO_RATES = [1, 1.25, 1.5, 2, 3, 4, 5, 7, 10];

    const e: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
    const esc = (v: unknown) => String(v ?? "").replace(/[&<>"']/g, (x) => e[x]);
    const t = (k: keyof (typeof c)["en"]) => c[s.lang][k];
    const displayPath = (path: string) => path.replace(/^\/root(?=\/|$)/, "") || "/";
    function safeWebUrl(input: string) {
      try {
        const url = new URL(input.trim());
        return url.protocol === "http:" || url.protocol === "https:" ? url.href : "";
      } catch {
        return "";
      }
    }

    function renderMarkdownInline(text: string) {
      const pattern = /(!?)\[([^\]\n]{0,200})\]\(([^)\s]+)\)/g;
      let html = "";
      let last = 0;
      for (const match of text.matchAll(pattern)) {
        html += esc(text.slice(last, match.index));
        const href = safeWebUrl(match[3]);
        if (href) {
          const label = esc(match[2]);
          html += match[1]
            ? `<img src="${esc(href)}" alt="${label}" loading="lazy" referrerpolicy="no-referrer" />`
            : `<a href="${esc(href)}" target="_blank" rel="noreferrer">${label || esc(href)}</a>`;
        } else {
          html += esc(match[0]);
        }
        last = (match.index || 0) + match[0].length;
      }
      html += esc(text.slice(last));
      return html;
    }

    function descriptionColor(line: string) {
      const hex = line.match(/^##([0-9a-f]{3}|[0-9a-f]{6}):/i);
      if (hex) {
        const value = hex[1].length === 3
          ? hex[1].split("").map((part) => `${part}${part}`).join("")
          : hex[1];
        return { color: `#${value}`, text: line.slice(hex[0].length) };
      }
      const rgb = line.match(/^##rgb\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})\s*\):/i);
      if (rgb && rgb.slice(1).every((value) => Number(value) <= 255)) {
        return { color: `rgb(${rgb[1]}, ${rgb[2]}, ${rgb[3]})`, text: line.slice(rgb[0].length) };
      }
      return { color: "", text: line };
    }

    function renderDescriptionLine(line: string) {
      const styled = descriptionColor(line);
      const content = renderMarkdownInline(styled.text);
      return styled.color ? `<span style="color:${styled.color}">${content}</span>` : content;
    }

    function renderMarkdown(source: string) {
      const blocks: string[] = [];
      const paragraph: string[] = [];
      const flushParagraph = () => {
        if (!paragraph.length) return;
        blocks.push(`<p>${paragraph.map(renderDescriptionLine).join("<br>")}</p>`);
        paragraph.length = 0;
      };
      for (const line of String(source || "").replace(/\r\n?/g, "\n").split("\n")) {
        if (!line.trim()) {
          flushParagraph();
          continue;
        }
        const heading = line.match(/^(#{1,3})\s+(.+)$/);
        if (heading) {
          flushParagraph();
          const level = heading[1].length + 2;
          blocks.push(`<h${level}>${renderDescriptionLine(heading[2])}</h${level}>`);
          continue;
        }
        paragraph.push(line);
      }
      flushParagraph();
      return blocks.join("");
    }

    function updateVisitorUrl(path: string, mode: NavigationMode) {
      if (mode === "none") return;
      const next = visitorUrl(path);
      if (location.pathname === next && !location.search && !location.hash) return;
      const state = { rpPath: path };
      if (mode === "replace") history.replaceState(state, "", next);
      else history.pushState(state, "", next);
    }
    const isFileRoute = (path: string) => /\.[a-z0-9]{1,12}$/i.test(path.split("/").pop() || "");
    const subtitleFontUrls = async (content: string, externalSignal?: AbortSignal) => {
      const characters = [...new Set([...content].filter((character) => {
        const point = character.codePointAt(0) || 0;
        return point >= 0x20 && point !== 0x7f;
      }))];
      const chunks = Array.from(
        { length: Math.max(1, Math.ceil(characters.length / 700)) },
        (_, part) => characters.slice(part * 700, (part + 1) * 700).join("")
      );
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 6000);
      const abortGoogleFonts = () => controller.abort();
      externalSignal?.addEventListener("abort", abortGoogleFonts, { once: true });
      try {
        const urls = await Promise.all(chunks.map(async (text) => {
          const url = new URL("https://fonts.googleapis.com/css2");
          url.searchParams.set("family", "Noto Sans SC:wght@400");
          url.searchParams.set("text", text);
          const response = await fetch(url, { signal: controller.signal });
          if (!response.ok) throw new Error("Font CSS request failed.");
          const css = await response.text();
          const font = css.match(/url\((https:\/\/[^)]+)\)/)?.[1];
          if (!font) throw new Error("Font URL was not found.");
          return font;
        }));
        const fonts = await Promise.all(urls.map(async (url) => {
          const response = await fetch(url, { signal: controller.signal });
          if (!response.ok) throw new Error("Font request failed.");
          return new Uint8Array(await response.arrayBuffer());
        }));
        return { fonts, defaultFont: "Noto Sans SC" };
      } catch {
        if (externalSignal?.aborted) throw new DOMException("Subtitle font loading was aborted.", "AbortError");
        const kana = [...content].filter((character) => {
          const point = character.codePointAt(0) || 0;
          return point >= 0x3040 && point <= 0x30ff;
        }).length;
        const han = [...content].filter((character) => {
          const point = character.codePointAt(0) || 0;
          return point >= 0x4e00 && point <= 0x9fff;
        }).length;
        const japanese = kana * 3 > han;
        const url = japanese ? "/fonts/NotoSansJP-Regular.woff2" : "/fonts/NotoSansSC-Regular.woff2";
        const response = await fetch(url, externalSignal ? { signal: externalSignal } : undefined);
        return {
          fonts: response.ok ? [new Uint8Array(await response.arrayBuffer())] : [],
          defaultFont: japanese ? "Noto Sans JP" : "Noto Sans SC"
        };
      } finally {
        window.clearTimeout(timer);
        externalSignal?.removeEventListener("abort", abortGoogleFonts);
      }
    };
    const normalizeAssFonts = (content: string, font: string) => {
      let styles = false;
      return content.split(/\r?\n/).map((line) => {
        if (/^\s*\[(V4\+? Styles)\]\s*$/i.test(line)) {
          styles = true;
          return line;
        }
        if (/^\s*\[.+\]\s*$/.test(line)) styles = false;
        if (styles && /^\s*Style\s*:/i.test(line)) {
          const fields = line.split(",");
          if (fields.length > 2) fields[1] = font;
          line = fields.join(",");
        }
        return line.replace(/\\fn[^\\}]+/g, `\\fn${font}`);
      }).join("\n");
    };
    const icon = (item: MediaItem) => {
      const id = item.isDir ? "iconFolder" : item.kind === "audio" ? "iconAudio" : item.kind === "image" ? "iconImage" : item.kind === "file" ? "iconFile" : "iconVideo";
      return document.querySelector<HTMLTemplateElement>(`#${id}`)?.innerHTML ?? "";
    };
    const type = (item: MediaItem) => item.isDir ? "folder" : item.kind || "video";
    const isProgressTracked = (item: MediaItem) => !item.isDir && (item.kind === "video" || item.kind === "audio");
    const hasPlayedProgress = (item: MediaItem) => isProgressTracked(item) && (readProgress(item.path)?.t ?? 0) > 0;

    function markLibraryItemPlayed(path: string) {
      if (!s.current || s.current.path !== path || !isProgressTracked(s.current)) return;
      for (const row of Array.from(d.list.querySelectorAll<HTMLElement>("[data-path]"))) {
        if (row.dataset.path === path) row.classList.add("is-played");
      }
    }

    function setStatus(el: HTMLElement, message = "", tone = "") {
      el.textContent = message;
      tone ? (el.dataset.tone = tone) : delete el.dataset.tone;
    }

    function cancelItemLoadingFeedback() {
      if (d.stage.dataset.signal !== "transfer") return;
      delete d.stage.dataset.signal;
      setStatus(d.playerStatus);
    }

    function renderStats() {
      d.playerStats.hidden = !s.current || s.current.kind === "file";
      if (!s.current || s.current.kind === "file") return;
      d.playCount.textContent = `${t("playCount")}: ${s.stat.plays}`;
      d.completionRate.textContent = `${t("completionRate")}: ${s.stat.rate}%`;
    }

    function resetStatSession(stat?: MediaStat) {
      statSession += 1;
      statPlayed = false;
      statCompleted = false;
      statProgress = 0;
      if (stat) s.stat = stat;
      renderStats();
    }

    function recordStat(event: "play" | "complete" | "progress", progress = 0) {
      if (!s.current) return Promise.resolve();
      if (event === "play") {
        if (statPlayed) return statTask;
        statPlayed = true;
      } else if (event === "complete") {
        if (statCompleted) return statTask;
        statCompleted = true;
      } else {
        const next = Math.min(1, Math.max(0, progress));
        if (next <= statProgress) return statTask;
        statProgress = next;
      }

      const session = statSession;
      const path = s.current.path;
      if (event === "play") trackVisitor("play", path);
      statTask = statTask.catch(() => undefined).then(async () => {
        const response = await fetch("/api/public/stat", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ path, event, progress: event === "progress" ? progress : undefined })
        });
        const data = (await response.json()) as { ok?: boolean; stat?: MediaStat };
        if (!response.ok || !data.ok || !data.stat) return;
        if (session !== statSession || s.current?.path !== path) return;
        s.stat = data.stat;
        renderStats();
      }).catch(() => undefined);
      return statTask;
    }

    function recordProgress(media: VideoMedia | HTMLAudioElement) {
      const duration = Number.isFinite(media.duration) && media.duration > 0 ? media.duration : 0;
      if (!duration || !s.current || !isProgressTracked(s.current)) return;
      const progress = media.currentTime / duration;
      if (progress > statProgress && progress > 0.5) recordStat("progress", progress);
    }

    function recordPlay() {
      if (statCompleted) resetStatSession();
      return recordStat("play");
    }

    function trackVisitor(event: "visit" | "directory" | "media" | "play", path: string) {
      fetch("/api/public/track", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ event, path }),
        keepalive: true
      }).catch(() => undefined);
    }

    const formatTime = (seconds: number) => {
      if (!Number.isFinite(seconds) || seconds < 0) return "00:00";
      const whole = Math.floor(seconds);
      const hours = Math.floor(whole / 3600);
      const minutes = Math.floor((whole % 3600) / 60);
      const rest = whole % 60;
      return hours
        ? `${hours}:${String(minutes).padStart(2, "0")}:${String(rest).padStart(2, "0")}`
        : `${String(minutes).padStart(2, "0")}:${String(rest).padStart(2, "0")}`;
    };

    const setRangeFill = (input: HTMLInputElement, value: number) => {
      input.style.setProperty("--range-fill", `${Math.max(0, Math.min(100, value))}%`);
    };

    const libraryMedia = window.matchMedia("(max-width: 680px)");
    const touchMedia = window.matchMedia("(hover: none), (pointer: coarse)");
    const isMobileLibraryAvailable = () => libraryMedia.matches && (touchMedia.matches || navigator.maxTouchPoints > 0);
    function setLibraryOpen(open: boolean) {
      const available = isMobileLibraryAvailable();
      const active = available && open;
      d.app.classList.toggle("is-library-open", active);
      d.libraryToggle.hidden = !available;
      d.libraryToggle.disabled = !available;
      d.libraryToggle.ariaExpanded = String(active);
      d.libraryToggle.ariaHidden = String(!available);
      const label = t(active ? "hideLibrary" : "showLibrary");
      d.libraryToggle.title = d.libraryToggle.ariaLabel = label;
      d.libraryScrim.setAttribute("aria-hidden", String(!active));
      d.libraryScrim.ariaLabel = t("hideLibrary");
    }

    function updateMediaNavigation() {
      const update = (kind: "video" | "audio", queue: MediaItem[], previous: HTMLButtonElement, next: HTMLButtonElement) => {
        const active = s.current?.kind === kind;
        const index = active ? queue.findIndex((item) => item.path === s.current?.path) : -1;
        previous.disabled = index <= 0;
        next.disabled = index < 0 || index >= queue.length - 1;
        previous.title = previous.ariaLabel = t("previous");
        next.title = next.ariaLabel = t("next");
      };
      update("video", s.videoQueue, d.videoPrevious, d.videoNext);
      update("audio", s.audioQueue, d.audioPrevious, d.audioNext);
    }

    async function playAdjacent(kind: "video" | "audio", direction: -1 | 1) {
      if (s.current?.kind !== kind) return;
      const queue = kind === "audio" ? s.audioQueue : s.videoQueue;
      const index = queue.findIndex((item) => item.path === s.current?.path);
      const target = queue[index + direction];
      if (index < 0 || !target) return;
      await openItem(target.path);
    }

    function scheduleControls(delay = 4200) {
      window.clearTimeout(controlTimer);
      if (ownsVideoControls()) return;
      if (seeking) return;
      controlTimer = window.setTimeout(() => d.videoFrame.classList.add("controls-hidden"), delay);
    }

    function showControls(lock = false) {
      window.clearTimeout(controlTimer);
      if (ownsVideoControls()) {
        d.videoFrame.classList.add("controls-hidden");
        return;
      }
      d.videoFrame.classList.remove("controls-hidden");
      if (!lock) scheduleControls();
    }

    function hideControls() {
      window.clearTimeout(controlTimer);
      if (ownsVideoControls()) return;
      if (!seeking) d.videoFrame.classList.add("controls-hidden");
    }

    function toggleVideoControls() {
      if (d.videoFrame.classList.contains("controls-hidden")) showControls();
      else hideControls();
    }

    function cycleVideoSpeed() {
      const media = activeVideo();
      const current = media.defaultPlaybackRate || media.playbackRate || 1;
      const index = VIDEO_RATES.findIndex((rate) => Math.abs(rate - current) < 0.01);
      const rate = VIDEO_RATES[(index + 1 + VIDEO_RATES.length) % VIDEO_RATES.length];
      media.defaultPlaybackRate = rate;
      media.playbackRate = rate;
      updateVideoControls();
    }

    function skipVideo(seconds: number) {
      const media = activeVideo();
      if (!Number.isFinite(media.duration)) return;
      media.currentTime = Math.max(0, Math.min(media.duration, media.currentTime + seconds));
      updateVideoControls();
    }

    function updateVideoControls() {
      const media = activeVideo();
      const paused = media.paused;
      const muted = media.muted || media.volume === 0;
      const fullscreen = isVideoFullscreen();
      const duration = Number.isFinite(media.duration) ? media.duration : 0;
      const rate = media.playbackRate || 1;
      d.videoFrame.dataset.playing = paused ? "0" : "1";
      d.playIcon.hidden = !paused;
      d.pauseIcon.hidden = paused;
      d.playToggle.title = d.playToggle.ariaLabel = t(paused ? "play" : "pause");
      d.volumeIcon.hidden = muted;
      d.mutedIcon.hidden = !muted;
      d.muteToggle.title = d.muteToggle.ariaLabel = t(muted ? "unmute" : "mute");
      d.speedValue.textContent = `${rate}×`;
      d.speedToggle.title = d.speedToggle.ariaLabel = `${t("speed")}: ${rate}×`;
      d.fullscreenIcon.hidden = fullscreen;
      d.exitFullscreenIcon.hidden = !fullscreen;
      d.fullscreenToggle.title = d.fullscreenToggle.ariaLabel = t(fullscreen ? "exitFullscreen" : "fullscreen");
      d.seek.ariaLabel = t("seek");
      d.volume.ariaLabel = t("volume");
      d.seek.max = String(duration);
      if (!seeking) d.seek.value = String(Math.min(media.currentTime || 0, duration));
      d.volume.value = String(muted ? 0 : media.volume);
      d.time.value = `${formatTime(media.currentTime)} / ${formatTime(duration)}`;
      setRangeFill(d.seek, duration ? (Number(d.seek.value) / duration) * 100 : 0);
      setRangeFill(d.volume, Number(d.volume.value) * 100);
    }

    function updateAudioControls() {
      const paused = d.audio.paused;
      const muted = d.audio.muted || d.audio.volume === 0;
      const duration = Number.isFinite(d.audio.duration) ? d.audio.duration : 0;
      const modeKey = s.audioMode === "one" ? "repeatOne" : s.audioMode === "list" ? "repeatList" : "shuffle";
      d.audioFrame.classList.toggle("is-playing", !paused);
      d.audioPlayIcon.hidden = !paused;
      d.audioPauseIcon.hidden = paused;
      d.audioPlayToggle.title = d.audioPlayToggle.ariaLabel = t(paused ? "play" : "pause");
      d.audioVolumeIcon.hidden = muted;
      d.audioMutedIcon.hidden = !muted;
      d.audioMuteToggle.title = d.audioMuteToggle.ariaLabel = t(muted ? "unmute" : "mute");
      d.audioModeOneIcon.hidden = s.audioMode !== "one";
      d.audioModeListIcon.hidden = s.audioMode !== "list";
      d.audioModeShuffleIcon.hidden = s.audioMode !== "shuffle";
      d.audioModeToggle.title = d.audioModeToggle.ariaLabel = t(modeKey);
      d.audioSeek.ariaLabel = t("seek");
      d.audioVolume.ariaLabel = t("volume");
      d.audioSeek.max = String(duration);
      if (!audioSeeking) d.audioSeek.value = String(Math.min(d.audio.currentTime || 0, duration));
      d.audioVolume.value = String(muted ? 0 : d.audio.volume);
      d.audioTime.value = `${formatTime(d.audio.currentTime)} / ${formatTime(duration)}`;
      setRangeFill(d.audioSeek, duration ? (Number(d.audioSeek.value) / duration) * 100 : 0);
      setRangeFill(d.audioVolume, Number(d.audioVolume.value) * 100);
    }

    function togglePlay() {
      const media = activeVideo();
      if (media.paused) media.play().catch(() => undefined);
      else media.pause();
    }

    function toggleAudioPlay() {
      if (d.audio.paused) d.audio.play().catch(() => undefined);
      else d.audio.pause();
    }

    function cycleAudioMode() {
      s.audioMode = s.audioMode === "one" ? "list" : s.audioMode === "list" ? "shuffle" : "one";
      updateAudioControls();
    }

    async function continueAudio() {
      if (s.audioMode === "one") {
        d.audio.currentTime = 0;
        await d.audio.play().catch(() => undefined);
        return;
      }

      const tracks = s.audioQueue;
      const alternatives = tracks.filter((item) => item.path !== s.current?.path);
      if (!alternatives.length) return;
      let next: MediaItem;
      if (s.audioMode === "shuffle") {
        next = alternatives[Math.floor(Math.random() * alternatives.length)];
      } else {
        const current = tracks.findIndex((item) => item.path === s.current?.path);
        next = tracks[(current + 1 + tracks.length) % tracks.length];
      }
      await openItem(next.path);
    }

    function setLyricsState(key: "lyricsLoading" | "lyricsEmpty" | "lyricsFailed") {
      d.lyricsPanel.hidden = false;
      d.lyricsList.classList.remove("is-intro");
      d.lyricsList.innerHTML = `<div class="lyrics-state">${esc(t(key))}</div>`;
    }

    function resetLyrics() {
      window.clearTimeout(s.lyricScrollTimer);
      s.lyricToken += 1;
      s.lyrics = [];
      s.lyricIndex = -1;
      s.lyricManual = false;
      d.lyricsList.classList.remove("is-intro");
      d.lyricsList.replaceChildren();
      d.lyricsPanel.hidden = true;
    }

    function centerLyric(line: HTMLElement, behavior: ScrollBehavior) {
      const listBox = d.lyricsList.getBoundingClientRect();
      const lineBox = line.getBoundingClientRect();
      const top = d.lyricsList.scrollTop + lineBox.top - listBox.top - (listBox.height - lineBox.height) / 2;
      d.lyricsList.scrollTo({ top: Math.max(0, top), behavior });
    }

    function pauseLyricFollow() {
      s.lyricManual = true;
      window.clearTimeout(s.lyricScrollTimer);
      s.lyricScrollTimer = window.setTimeout(() => {
        s.lyricManual = false;
        syncLyrics(true);
      }, 3000);
    }

    function renderLyricText(text: string, words?: LyricWord[]) {
      if (!words?.length) return esc(text);
      let cursor = 0;
      const chunks: string[] = [];
      for (const word of words) {
        const position = text.indexOf(word.text, cursor);
        if (position < cursor) return esc(text);
        chunks.push(esc(text.slice(cursor, position)));
        chunks.push(`<span class="lyric-word" data-word-at="${esc(word.at)}" data-word-end="${esc(word.at + word.duration)}">${esc(word.text)}</span>`);
        cursor = position + word.text.length;
      }
      chunks.push(esc(text.slice(cursor)));
      return chunks.join("");
    }

    function syncLyricWords(now: number) {
      const line = d.lyricsList.querySelector<HTMLElement>(`[data-lyric="${s.lyricIndex}"]`);
      if (!line) return;
      line.querySelectorAll<HTMLElement>(".lyric-word").forEach((word) => {
        const at = Number(word.dataset.wordAt);
        const end = Number(word.dataset.wordEnd);
        if (!Number.isFinite(at) || !Number.isFinite(end)) return;
        const progress = end > at
          ? Math.max(0, Math.min(1, (now - at) / (end - at)))
          : now >= at ? 1 : 0;
        word.style.setProperty("--lyric-word-progress", `${progress * 100}%`);
        word.classList.toggle("is-current", progress > 0 && progress < 1);
        word.classList.toggle("is-played", progress >= 1);
      });
    }

    function runLyricFrame() {
      lyricFrame = 0;
      if (d.audio.paused || !s.lyrics.length) return;
      syncLyrics();
      startLyricFrame();
    }

    function startLyricFrame() {
      if (lyricFrame || d.audio.paused || !d.lyricsList.querySelector(".lyric-word")) return;
      lyricFrame = requestAnimationFrame(runLyricFrame);
    }

    function stopLyricFrame() {
      if (!lyricFrame) return;
      cancelAnimationFrame(lyricFrame);
      lyricFrame = 0;
    }

    function syncLyrics(force = false) {
      if (!s.lyrics.length) return;
      const now = d.audio.currentTime + 0.05;
      let low = 0;
      let high = s.lyrics.length - 1;
      let index = -1;
      while (low <= high) {
        const middle = (low + high) >> 1;
        if (s.lyrics[middle].at <= now) {
          index = middle;
          low = middle + 1;
        } else {
          high = middle - 1;
        }
      }
      d.lyricsList.classList.toggle("is-intro", index < Math.min(3, s.lyrics.length));
      if (!force && index === s.lyricIndex) {
        syncLyricWords(now);
        return;
      }

      const previous = d.lyricsList.querySelector<HTMLElement>(".is-active");
      previous?.classList.remove("is-active");
      previous?.removeAttribute("aria-current");
      s.lyricIndex = index;
      if (index < 0) {
        d.lyricsList.scrollTo({ top: 0, behavior: force ? "auto" : "smooth" });
        return;
      }

      const line = d.lyricsList.querySelector<HTMLElement>(`[data-lyric="${index}"]`);
      if (!line) return;
      line.classList.add("is-active");
      line.setAttribute("aria-current", "true");
      syncLyricWords(now);
      if (force || !s.lyricManual) centerLyric(line, force ? "auto" : "smooth");
    }

    function renderLyrics(cues: LyricCue[]) {
      s.lyrics = cues;
      s.lyricIndex = -1;
      if (!cues.length) return setLyricsState("lyricsEmpty");
      d.lyricsPanel.hidden = false;
      d.lyricsList.classList.add("is-intro");
      d.lyricsList.innerHTML = cues.map((cue, index) => {
        const top = cue.top || cue.bottom || "";
        const bottom = cue.top ? cue.bottom : undefined;
        return `
          <button class="lyric-line" type="button" data-lyric="${index}" data-at="${cue.at}">
            <span class="lyric-top">${renderLyricText(top, cue.top ? cue.words : cue.bottomWords)}</span>
            ${bottom ? `<span class="lyric-bottom">${renderLyricText(bottom, cue.top ? cue.bottomWords : undefined)}</span>` : ""}
          </button>
        `;
      }).join("");
      syncLyrics(true);
      startLyricFrame();
    }

    async function loadLyrics(item: MediaItem) {
      const token = ++s.lyricToken;
      setLyricsState("lyricsLoading");
      const fetchTrack = async (slot: 1 | 2) => {
        const response = await fetch(`/api/public/lyric?path=${encodeURIComponent(item.path)}&n=${slot}`);
        if (!response.ok) throw new Error("Lyrics request failed.");
        return response.text();
      };
      const [primary, other] = await Promise.all([
        item.lrc ? fetchTrack(1).catch(() => null) : Promise.resolve(null),
        item.lrc2 ? fetchTrack(2).catch(() => null) : Promise.resolve(null)
      ]);
      if (token !== s.lyricToken) return;
      if (primary === null && other === null) return setLyricsState("lyricsFailed");
      renderLyrics(primary && other ? buildLyrics(primary, other) : buildLyrics(primary || other || ""));
    }

    type WebkitVideo = HTMLVideoElement & {
      webkitEnterFullscreen?: () => void;
      webkitExitFullscreen?: () => void;
      webkitDisplayingFullscreen?: boolean;
    };
    type WebkitDocument = Document & { webkitFullscreenElement?: Element | null; webkitExitFullscreen?: () => void };
    const webkitVideo = d.video as WebkitVideo;
    const webkitDocument = document as WebkitDocument;
    function isVideoFullscreen() {
      return document.fullscreenElement === d.videoFrame || webkitDocument.webkitFullscreenElement === d.videoFrame || Boolean(webkitVideo.webkitDisplayingFullscreen);
    }

    async function toggleFullscreen() {
      if (document.fullscreenElement || webkitDocument.webkitFullscreenElement || webkitVideo.webkitDisplayingFullscreen) {
        if (document.fullscreenElement && document.exitFullscreen) await document.exitFullscreen();
        else webkitDocument.webkitExitFullscreen?.();
      } else {
        try {
          if (d.videoFrame.requestFullscreen) await d.videoFrame.requestFullscreen();
          else throw new Error("Fullscreen API unavailable");
        } catch {
          // iPadOS Safari exposes fullscreen on the video element rather than its custom container.
          if (webkitVideo.webkitEnterFullscreen) webkitVideo.webkitEnterFullscreen();
          else if ((d.videoFrame as HTMLElement & { webkitRequestFullscreen?: () => Promise<void> }).webkitRequestFullscreen) await (d.videoFrame as HTMLElement & { webkitRequestFullscreen: () => Promise<void> }).webkitRequestFullscreen();
          else throw new Error("Fullscreen is unavailable on this browser");
        }
      }
      if (!webkitVideo.webkitDisplayingFullscreen) d.videoFrame.focus({ preventScroll: true });
    }

    function applyLanguage() {
      document.documentElement.lang = s.lang === "zh" ? "zh-CN" : s.lang === "ja" ? "ja" : "en";
      document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
        const key = el.dataset.i18n as keyof (typeof c)["en"];
        if (key && c[s.lang][key]) el.textContent = t(key);
      });
      document.querySelectorAll<HTMLElement>("[data-i18n-title]").forEach((el) => {
        const key = el.dataset.i18nTitle as keyof (typeof c)["en"];
        if (key && c[s.lang][key]) el.title = t(key);
      });
      document.querySelectorAll<HTMLInputElement>("[data-i18n-placeholder]").forEach((el) => {
        const key = el.dataset.i18nPlaceholder as keyof (typeof c)["en"];
        if (key && c[s.lang][key]) el.placeholder = t(key);
      });
      d.subtitleSelect.setAttribute("aria-label", t("subtitleTrack"));
      updateVideoControls();
      updateAudioControls();
      setLibraryOpen(d.app.classList.contains("is-library-open"));
      render();
      renderCurrent();
      renderStats();
    }

    function render() {
      d.path.textContent = displayPath(s.path);
      d.parent.disabled = s.path === "/root";
      const items = s.items;
      d.count.textContent = `${items.length} ${items.length === 1 ? t("item") : t("items")}`;
      if (!items.length) {
        d.list.innerHTML = `<div class="list-state">${esc(t("empty"))}</div>`;
        return;
      }
      d.list.innerHTML = items.map((item) => `
        <button class="file-row${s.current?.path === item.path ? " is-active" : ""}${hasPlayedProgress(item) ? " is-played" : ""}" type="button" data-path="${esc(item.path)}" data-dir="${item.isDir ? "1" : "0"}">
          <span class="file-icon file-icon-${esc(type(item))}">${icon(item)}</span>
          <span class="file-copy">
            <strong>${esc(item.name)}</strong>
            <small>${esc(s.query ? displayPath(item.path) : item.artist || t(type(item) as "folder" | "video" | "audio" | "image" | "file"))}</small>
          </span>
        </button>
      `).join("");
    }

    function renderCurrent() {
      updateMediaNavigation();
      if (!s.current) return;
      d.kind.textContent = t(s.current.kind || "video");
      d.title.textContent = s.current.name;
      d.mediaPath.textContent = s.current.artist || displayPath(s.current.path);
      if (s.current.kind === "video" && s.current.embeddedMulti) {
        renderSubtitleOptions();
      } else {
        d.subtitleSelector.hidden = true;
        d.videoBackendSelector.hidden = true;
        // Do not show a "No subtitles" badge while an ordinary video is
        // still being inspected for an embedded track.  It is also omitted
        // when the inspection finds no subtitle at all.
        d.subtitle.hidden = s.current.kind !== "video" || !s.current.sub;
        d.subtitleText.textContent = s.current.sub ? "ASS" : "";
      }
      d.lyricsBadge.hidden = !s.current.lrc && !s.current.lrc2;
      d.nowPlaying.hidden = s.current.kind === "file";
      d.fileDownload.textContent = t("download");
    }

    async function load(path = s.path, query = d.search.value.trim(), navigation: NavigationMode = "none") {
      if (navigation !== "none") {
        routeRequest += 1;
        itemRequest += 1;
        itemAbortController?.abort();
        subtitleAbortController?.abort();
        cancelItemLoadingFeedback();
      }
      const route = routeRequest;
      const request = ++listRequest;
      setStatus(d.libraryStatus, t("loading"));
      let data: any;
      try {
        const response = await fetch("/api/public/list", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ path, q: query })
        });
        data = await response.json();
      } catch (error) {
        if (request !== listRequest || route !== routeRequest) {
          if (request === listRequest) setStatus(d.libraryStatus);
          return false;
        }
        throw error;
      }
      if (request !== listRequest || route !== routeRequest) {
        if (request === listRequest) setStatus(d.libraryStatus);
        return false;
      }
      if (!data.ok) throw new Error(data.details || data.error || t("loadFailed"));
      s.path = data.path || "/root";
      s.items = data.items || [];
      s.query = data.query || "";
      setStatus(d.libraryStatus);
      render();
      updateVisitorUrl(s.path, navigation);
      if (navigation !== "none") trackVisitor(s.path === "/root" ? "visit" : "directory", s.path);
      return true;
    }

    function clearSearch() {
      window.clearTimeout(searchTimer);
      d.search.value = "";
      s.query = "";
    }

    async function clearMedia() {
      saveProgress(true);
      subtitleAbortController?.abort();
      subtitleAbortController = null;
      await destroyVideoSubtitle();
      destroyPlaysVideo();
      destroyMoviVideo();
      destroyVPlayer();
      s.videoBackend = "default";
      s.playsVideoTracks = [];
      s.nativeEmbeddedSubtitle = null;
      s.moviSubtitleTracks = [];
      s.subtitleSelection = "off";
      d.subtitle.hidden = true;
      d.subtitleSelector.hidden = true;
      d.video.pause();
      d.video.autoplay = false;
      d.video.hidden = true;
      d.videoBackendSelector.hidden = true;
      d.movi.hidden = true;
      d.audio.pause();
      d.video.removeAttribute("src");
      d.video.load();
      d.audio.removeAttribute("src");
      d.audio.load();
      stopLyricFrame();
      d.image.removeAttribute("src");
      d.fileDownload.href = "#";
      d.fileDescription.innerHTML = "";
      d.videoFrame.hidden = true;
      delete d.videoFrame.dataset.subtitleReady;
      d.videoFrame.classList.remove("controls-hidden");
      window.clearTimeout(controlTimer);
      d.imageFrame.hidden = true;
      d.fileFrame.hidden = true;
      d.audioFrame.hidden = true;
      d.audioFrame.classList.remove("is-playing");
      d.audioSeek.value = "0";
      d.audioSeek.max = "0";
      d.audioTime.value = "00:00 / 00:00";
      setRangeFill(d.audioSeek, 0);
      delete d.stage.dataset.mode;
      resetLyrics();
      d.empty.hidden = true;
    }

    async function requestItem(path: string, allowMissing = false, signal?: AbortSignal): Promise<ItemPayload | null> {
      const response = await fetch("/api/public/item", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ path }),
        signal
      });
      const data = (await response.json()) as ItemPayload & { ok?: boolean; error?: string; details?: string };
      if (allowMissing && response.status === 404) return null;
      if (!response.ok || !data.ok) throw new Error(data.details || data.error || t("itemFailed"));
      return data;
    }

    function isCurrentItemLoad(request: number, route: number, signal: AbortSignal) {
      return request === itemRequest && route === routeRequest && !signal.aborted;
    }

    async function destroyVideoSubtitle() {
      const ass = s.ass;
      s.ass = null;
      delete d.videoFrame.dataset.subtitleReady;
      if (ass) await ass.destroy().catch(() => undefined);
    }

    function destroyPlaysVideo() {
      const engine = s.playsVideoEngine;
      s.playsVideoEngine = null;
      s.playsVideoActive = false;
      engine?.destroy();
    }

    function destroyVPlayer() {
      const root = s.vplayerRoot;
      s.vplayerRoot = null;
      s.vplayerVideo = null;
      root?.unmount();
      d.vplayerHost.replaceChildren();
      d.vplayerHost.hidden = true;
    }

    function releaseMoviSource() {
      if (typeof d.movi.pause === "function") {
        d.movi.pause();
        d.movi.src = null;
      }
      if (typeof d.movi.setSubtitleRenderer === "function") {
        d.movi.setSubtitleRenderer(null);
      }
      s.moviActive = false;
      if (s.moviExternalObjectUrl) URL.revokeObjectURL(s.moviExternalObjectUrl);
      s.moviExternalObjectUrl = null;
    }

    function destroyMoviVideo() {
      releaseMoviSource();
      s.moviSubtitleTracks = [];
      s.moviSubtitleFonts = [];
      s.moviSubtitleRenderer = null;
      s.moviExternalSubtitle = null;
      s.externalSubtitleRaw = null;
      d.videoFrame.dataset.backend = "native";
    }

    function setMoviAssRenderer(track: MoviSubtitleTrack | undefined) {
      if (!isAssMoviTrack(track)) {
        d.movi.setSubtitleRenderer(null);
        s.moviSubtitleRenderer = null;
        return;
      }
      if (!s.moviSubtitleRenderer) {
        s.moviSubtitleRenderer = new MoviAssRenderer(s.moviSubtitleFonts);
        d.movi.setSubtitleRenderer(s.moviSubtitleRenderer);
      }
    }

    function subtitleTrackLabel(track: MoviSubtitleTrack, index: number) {
      return track.label?.trim() || track.language?.trim() || `${t("subtitleTrack")} ${index + 1}`;
    }

    function embeddedSubtitleIndex(selection: SubtitleSelection) {
      if (!selection.startsWith("embedded:")) return -1;
      const id = Number(selection.slice("embedded:".length));
      return Number.isInteger(id) ? id : -1;
    }

    function assTimestampToSeconds(value: string) {
      const match = value.trim().match(/^(\d+):(\d{1,2}):(\d{1,2})[.:](\d{1,2})$/);
      if (!match) return 0;
      return Number(match[1]) * 3600 + Number(match[2]) * 60 + Number(match[3]) + Number(match[4]) / 100;
    }

    function vttTimestamp(seconds: number) {
      const milliseconds = Math.max(0, Math.round(seconds * 1000));
      const hours = Math.floor(milliseconds / 3600000);
      const minutes = Math.floor((milliseconds % 3600000) / 60000);
      const rest = milliseconds % 60000;
      return `${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(Math.floor(rest / 1000)).padStart(2, "0")}.${String(rest % 1000).padStart(3, "0")}`;
    }

    function assToWebVtt(content: string) {
      if (/^\s*WEBVTT/i.test(content)) return content;
      const cues: string[] = [];
      for (const line of content.split(/\r?\n/)) {
        const match = line.match(/^\s*Dialogue:\s*(.*)$/i);
        if (!match) continue;
        const fields = match[1].split(",");
        if (fields.length < 10) continue;
        const start = assTimestampToSeconds(fields[1]);
        const end = assTimestampToSeconds(fields[2]);
        const text = fields.slice(9).join(",")
          .replace(/\{[^}]*\}/g, "")
          .replace(/\\N/g, "\n")
          .replace(/\\n/g, "\n")
          .replace(/\\h/g, " ")
          .trim();
        if (!text || end <= start) continue;
        cues.push(`${vttTimestamp(start)} --> ${vttTimestamp(end)}\n${text}`);
      }
      if (cues.length) return `WEBVTT\n\n${cues.join("\n\n")}\n`;
      return content;
    }

    async function applyMoviSubtitle(request: number, route: number, signal: AbortSignal) {
      if (!isCurrentItemLoad(request, route, signal) || !s.moviActive) return false;
      await destroyVideoSubtitle();
      const player = d.movi.player;
      if (!player) return false;
      if (s.subtitleSelection === "off") {
        setMoviAssRenderer(undefined);
        await player.selectSubtitleTrack(null);
        if (s.moviExternalSubtitle) await player.selectSubtitleLang(null);
        renderSubtitleOptions();
        return true;
      }
      if (s.subtitleSelection === "external") {
        setMoviAssRenderer(undefined);
        const selected = s.moviExternalSubtitle
          ? await player.selectSubtitleLang(s.moviExternalSubtitle)
          : false;
        renderSubtitleOptions();
        return selected;
      }
      const id = embeddedSubtitleIndex(s.subtitleSelection);
      if (s.moviExternalSubtitle) await player.selectSubtitleLang(null);
      const track = s.moviSubtitleTracks.find((candidate) => candidate.id === id);
      setMoviAssRenderer(track);
      const selected = id >= 0 && s.moviSubtitleTracks.some((track) => track.id === id)
        ? await player.selectSubtitleTrack(id)
        : false;
      renderSubtitleOptions();
      return selected;
    }

    function collectPlaysVideoTracks() {
      const engine = s.playsVideoEngine;
      if (!engine) return;
      const infos = (engine as any).subtitleTracks as Array<{ name?: string; language?: string; codec?: string }>;
      s.playsVideoTracks = (infos || []).map((info, index) => ({
        id: index,
        index,
        label: [info.name, info.language, info.codec].filter(Boolean).join(" · ") || `${t("subtitleTrack")} ${index + 1}`
      }));
    }

    async function applyPlaysVideoSubtitle(request: number, route: number, signal: AbortSignal) {
      if (!isCurrentItemLoad(request, route, signal) || !s.playsVideoActive) return false;
      await destroyVideoSubtitle();
      const tracks = Array.from(d.video.textTracks);
      tracks.forEach((track) => (track.mode = "disabled"));
      if (s.subtitleSelection === "off") return true;
      if (s.subtitleSelection === "external") {
        if (!s.externalSubtitleRaw?.trim()) return false;
        await installVideoSubtitle(s.externalSubtitleRaw, request, route, signal);
        return true;
      }
      const id = embeddedSubtitleIndex(s.subtitleSelection);
      const option = s.playsVideoTracks.find((track) => track.id === id);
      const textTracks = Array.from(d.video.textTracks).filter((track) =>
        track.kind === "subtitles" || track.kind === "captions"
      );
      const textTrack = option ? textTracks[option.index] : undefined;
      if (!textTrack) return false;
      textTrack.mode = "showing";
      return true;
    }

    async function applyDefaultSubtitle(request: number, route: number, signal: AbortSignal) {
      if (!isCurrentItemLoad(request, route, signal) || s.videoBackend !== "default") return false;
      await destroyVideoSubtitle();
      if (s.subtitleSelection === "off") return true;
      const raw = s.subtitleSelection === "external"
        ? s.externalSubtitleRaw
        : s.nativeEmbeddedSubtitle?.raw;
      if (!raw?.trim()) return false;
      await installVideoSubtitle(raw, request, route, signal);
      return true;
    }

    async function applySelectedVideoSubtitle(request: number, route: number, signal: AbortSignal) {
      if (s.videoBackend === "playsvideo") return applyPlaysVideoSubtitle(request, route, signal);
      if (s.videoBackend === "default") return applyDefaultSubtitle(request, route, signal);
      return applyMoviSubtitle(request, route, signal);
    }

    function renderSubtitleOptions() {
      const current = s.current;
      const multi = current?.kind === "video" && Boolean(current.embeddedMulti);
      const canChooseBackend = multi && current?.h5Player === "select";
      d.videoBackendSelector.hidden = !canChooseBackend;
      d.videoBackendSelect.value = s.videoBackend;
      d.subtitleSelector.hidden = !multi || s.videoBackend === "vplayer";
      if (!multi) return;

      const options: Array<{ value: SubtitleSelection; label: string }> = [
        { value: "off", label: t("subtitleOff") }
      ];
      if (s.videoBackend === "movi" && s.moviExternalSubtitle) {
        options.push({ value: "external", label: t("externalSubtitle") });
      } else if (s.videoBackend !== "movi" && (s.moviExternalSubtitle || s.externalSubtitleRaw)) {
        options.push({ value: "external", label: t("externalSubtitle") });
      }
      const tracks: VideoSubtitleOption[] = s.videoBackend === "movi"
        ? s.moviSubtitleTracks.map((track, index) => ({ id: track.id, index, label: subtitleTrackLabel(track, index) }))
        : s.videoBackend === "playsvideo"
          ? s.playsVideoTracks
          : s.videoBackend === "default" && s.nativeEmbeddedSubtitle
            ? [{ id: 0, index: 0, label: s.nativeEmbeddedSubtitle.label }]
            : [];
      for (const track of tracks) {
        options.push({ value: `embedded:${track.id}`, label: track.label });
      }
      if (!options.some((option) => option.value === s.subtitleSelection)) {
        s.subtitleSelection = s.moviExternalSubtitle
          ? "external"
          : s.moviSubtitleTracks[0]
            ? `embedded:${s.moviSubtitleTracks[0].id}`
            : "off";
      }
      d.subtitleSelect.replaceChildren(...options.map((option) => {
        const element = document.createElement("option");
        element.value = option.value;
        element.textContent = option.label;
        return element;
      }));
      d.subtitleSelect.value = s.subtitleSelection;
      d.subtitle.hidden = s.subtitleSelection === "off";
      const embeddedId = embeddedSubtitleIndex(s.subtitleSelection);
      const embeddedTrack = tracks.find((track) => track.id === embeddedId);
      d.subtitleText.textContent = s.subtitleSelection === "external"
        ? "ASS"
        : embeddedTrack
          ? embeddedTrack.label
          : t("noSubtitle");
    }

    async function installVideoSubtitle(rawSubtitle: string, request: number, route: number, signal: AbortSignal) {
      if (!rawSubtitle.trim() || !isCurrentItemLoad(request, route, signal)) return;
      await destroyVideoSubtitle();
      const subContent = normalizeAssFonts(rawSubtitle, "Noto Sans SC");
      let ass: JASSUB | null = null;
      try {
        const { default: JASSUBModule } = await import("jassub");
        if (!isCurrentItemLoad(request, route, signal)) return;
        ass = new JASSUBModule({
          video: d.video,
          subContent
        });
        if (!isCurrentItemLoad(request, route, signal)) {
          if (s.ass === ass) s.ass = null;
          await ass.destroy().catch(() => undefined);
          return;
        }
        s.ass = ass;
        d.videoFrame.dataset.subtitleReady = "0";
        const fontPromise = subtitleFontUrls(rawSubtitle, signal);
        const [, font] = await Promise.all([ass.ready, fontPromise]);
        if (!isCurrentItemLoad(request, route, signal) || s.ass !== ass) {
          if (s.ass === ass) s.ass = null;
          await ass.destroy().catch(() => undefined);
          return;
        }
        await ass.renderer.addFonts(font.fonts);
        ass.renderer.setDefaultFont(font.defaultFont);
        await ass.resize(true);
        if (isCurrentItemLoad(request, route, signal) && s.ass === ass) {
          d.videoFrame.dataset.subtitleReady = "1";
        }
      } catch (error) {
        if (s.ass === ass) {
          s.ass = null;
          await ass?.destroy().catch(() => undefined);
        }
        throw error;
      }
    }

    function textFromEbml(value: unknown) {
      if (typeof value === "string") return value;
      if (value instanceof ArrayBuffer) return new TextDecoder().decode(new Uint8Array(value));
      if (ArrayBuffer.isView(value)) {
        return new TextDecoder().decode(new Uint8Array(value.buffer, value.byteOffset, value.byteLength));
      }
      return value && typeof (value as { toString?: () => string }).toString === "function"
        ? (value as { toString: () => string }).toString()
        : "";
    }

    function assTime(seconds: number) {
      const centiseconds = Math.max(0, Math.floor((Number(seconds) || 0) * 100));
      const hours = Math.floor(centiseconds / 360000);
      const minutes = Math.floor((centiseconds % 360000) / 6000);
      const rest = Math.floor((centiseconds % 6000) / 100);
      return `${hours}:${String(minutes).padStart(2, "0")}:${String(rest).padStart(2, "0")}.${String(centiseconds % 100).padStart(2, "0")}`;
    }

    function writeEbmlBytes(decoder: unknown, bytes: Uint8Array) {
      const parts: string[] = [];
      const blockSize = 0x8000;
      for (let offset = 0; offset < bytes.length; offset += blockSize) {
        parts.push(String.fromCharCode(...bytes.subarray(offset, offset + blockSize)));
      }
      (decoder as { write(chunk: string, encoding: "binary"): unknown }).write(parts.join(""), "binary");
    }

    function isAssMoviTrack(track: MoviSubtitleTrack | null | undefined) {
      return Boolean(track && /(?:ass|ssa)/i.test(track.codec));
    }

    class MoviAssRenderer implements MoviSubtitleRenderer {
      private overlay: HTMLElement | null = null;
      private canvas: HTMLCanvasElement | null = null;
      private ass: JASSUB | null = null;
      private fonts: Uint8Array[];
      private generation = 0;
      private packetQueue: Promise<void> = Promise.resolve();
      private delay = 0;

      constructor(fonts: Uint8Array[]) {
        this.fonts = fonts;
      }

      mount(container: HTMLElement) {
        this.overlay = container;
        if (this.canvas && this.canvas.parentElement !== container) container.appendChild(this.canvas);
      }

      async configure(track: MoviSubtitleTrack, extradata?: Uint8Array, fonts?: Uint8Array[]) {
        const generation = ++this.generation;
        const previous = this.ass;
        this.ass = null;
        await this.packetQueue.catch(() => undefined);
        if (previous) await previous.destroy().catch(() => undefined);
        if (generation !== this.generation) return;
        this.canvas?.remove();
        this.canvas = null;
        if (!isAssMoviTrack(track) || !this.overlay) return;

        const bytes = extradata || track.extradata;
        let header = bytes ? new TextDecoder().decode(bytes) : "";
        header = header.replace(/^\uFEFF/, "").replace(/\r\n?/g, "\n").trim();
        if (!header) {
          header = [
            "[Script Info]",
            "ScriptType: v4.00+",
            "PlayResX: 1920",
            "PlayResY: 1080",
            "[V4+ Styles]",
            "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding",
            "Style: Default,Noto Sans SC,48,&H00FFFFFF,&H000000FF,&H00000000,&H80000000,0,0,0,0,100,100,0,0,1,2,1,2,20,20,30,1"
          ].join("\n");
        }
        if (!/^\s*\[Events\]/im.test(header)) {
          header += "\n\n[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text";
        }

        const canvas = document.createElement("canvas");
        canvas.setAttribute("aria-hidden", "true");
        canvas.style.cssText = "position:absolute;inset:0;width:100%;height:100%;pointer-events:none";
        this.overlay.appendChild(canvas);
        this.canvas = canvas;
        const { default: JASSUBModule } = await import("jassub");
        if (generation !== this.generation || !this.overlay) {
          if (this.canvas === canvas) {
            canvas.remove();
            this.canvas = null;
          }
          return;
        }
        const ass = new JASSUBModule({
          canvas,
          subContent: header,
          fonts: [...this.fonts, ...(fonts || [])],
          availableFonts: { "Noto Sans SC": "/fonts/NotoSansSC-Regular.woff2" },
          defaultFont: "Noto Sans SC",
          queryFonts: "local"
        });
        this.ass = ass;
        await ass.ready;
        if (generation !== this.generation || this.ass !== ass) {
          await ass.destroy().catch(() => undefined);
          return;
        }
        this.setDelay(this.delay);
      }

      pushPacket(packet: Parameters<MoviSubtitleRenderer["pushPacket"]>[0]) {
        const ass = this.ass;
        const generation = this.generation;
        if (!ass || !packet.data.length) return;
        this.packetQueue = this.packetQueue.then(async () => {
          await ass.ready;
          if (this.ass !== ass || generation !== this.generation) return;
          const fields = new TextDecoder().decode(packet.data).replace(/\0+$/, "").split(",");
          if (fields.length < 9) return;
          const start = Math.max(0, packet.timestamp);
          const duration = packet.duration > 0 ? packet.duration : 3;
          const end = Math.max(start + 0.01, start + duration);
          const dialogue = `Dialogue: ${fields[1]},${assTime(start)},${assTime(end)},${fields.slice(2).join(",")}`;
          await ass.renderer.processData(dialogue);
        }).catch((error) => console.warn("Could not pass an embedded ASS subtitle packet to JASSUB.", error));
        return this.packetQueue;
      }

      render(mediaTime: number, videoWidth: number, videoHeight: number) {
        if (!this.ass || videoWidth <= 0 || videoHeight <= 0) return;
        return this.ass.manualRender({
          expectedDisplayTime: performance.now(),
          width: videoWidth,
          height: videoHeight,
          mediaTime
        });
      }

      setDelay(seconds: number) {
        this.delay = Number.isFinite(seconds) ? seconds : 0;
        if (this.ass) this.ass.timeOffset = -this.delay;
      }

      clear() {
        // Keep parsed events across seeks so JASSUB can render cues when seeking backward.
      }

      async destroy() {
        this.generation += 1;
        const ass = this.ass;
        this.ass = null;
        await this.packetQueue.catch(() => undefined);
        if (ass) await ass.destroy().catch(() => undefined);
        this.canvas?.remove();
        this.canvas = null;
        this.overlay = null;
        this.fonts = [];
      }
    }

    async function extractMkvFonts(url: string, signal: AbortSignal) {
      const { Decoder } = await import("ebml/lib/ebml.esm.js");
      const decoder = new Decoder();
      const fonts: Uint8Array[] = [];
      const maxScanBytes = 12 * 1024 * 1024;
      const rangeSize = 1024 * 1024;
      const maxFontBytes = 16 * 1024 * 1024;
      const maxTotalFontBytes = 32 * 1024 * 1024;
      let totalFontBytes = 0;
      let currentAttachment: { name: string; mime: string; data: Uint8Array | null } | null = null;
      let attachmentsSeen = false;
      let scanComplete = false;
      let decoderError: unknown = null;

      decoder.on("error", (error: unknown) => {
        decoderError = error;
      });
      decoder.on("data", (entry: [string, Record<string, any>]) => {
        const [kind, tag] = entry;
        if (tag.name === "Attachments" && kind === "start") attachmentsSeen = true;
        if (tag.name === "Cluster" && kind === "start" && !attachmentsSeen) scanComplete = true;
        if (tag.name === "AttachedFile" && kind === "start") {
          currentAttachment = { name: "", mime: "", data: null };
          return;
        }
        if (tag.name === "AttachedFile" && kind === "end" && currentAttachment) {
          if (currentAttachment.data) {
            fonts.push(currentAttachment.data);
            totalFontBytes += currentAttachment.data.byteLength;
          }
          currentAttachment = null;
          return;
        }
        if (tag.name === "Attachments" && kind === "end") {
          scanComplete = true;
          return;
        }
        if (!currentAttachment || kind !== "tag") return;
        if (tag.name === "FileName") currentAttachment.name = String(tag.value || "");
        else if (tag.name === "FileMimeType") currentAttachment.mime = String(tag.value || "");
        else if (tag.name === "FileData") {
          const isFont = /\.(?:ttf|otf|ttc|otc|woff2?)$/i.test(currentAttachment.name) || /font|opentype/i.test(currentAttachment.mime);
          const data = tag.data;
          if (isFont && data instanceof Uint8Array && data.byteLength > 0 && data.byteLength <= maxFontBytes && totalFontBytes + data.byteLength <= maxTotalFontBytes) {
            currentAttachment.data = new Uint8Array(data);
          }
        }
      });

      for (let offset = 0; offset < maxScanBytes && !scanComplete && !signal.aborted; offset += rangeSize) {
        const rangeEnd = Math.min(offset + rangeSize - 1, maxScanBytes - 1);
        const response = await fetch(url, {
          headers: { range: `bytes=${offset}-${rangeEnd}` },
          cache: "no-store",
          signal
        });
        const contentRange = response.headers.get("content-range") || "";
        const rangeMatch = contentRange.match(/^bytes\s+(\d+)-(\d+)\//i);
        if (response.status !== 206 || !rangeMatch || Number(rangeMatch[1]) !== offset) {
          await response.body?.cancel().catch(() => undefined);
          break;
        }
        const chunk = new Uint8Array(await response.arrayBuffer());
        if (!chunk.length) break;
        writeEbmlBytes(decoder, chunk);
        if (decoderError) throw decoderError;
        if (chunk.byteLength < rangeEnd - offset + 1) break;
      }
      if (decoderError) throw decoderError;
      return fonts;
    }

    async function parseEmbeddedVideoSubtitles(
      item: MediaItem,
      request: number,
      route: number,
      signal: AbortSignal
    ): Promise<EmbeddedSubtitle[]> {
      if (!/\.mkv(?:$|[?#])/i.test(`${item.name} ${item.path}`) || !item.url) return [];
      const [response, { Decoder }] = await Promise.all([
        fetch(item.url, { signal }),
        import("ebml/lib/ebml.esm.js")
      ]);
      if (!response.ok || !response.body) return [];
      if (!isCurrentItemLoad(request, route, signal)) return [];

      type Track = { number: number; type: number; codec: string; privateData: string; name: string; language: string; default: boolean };
      type Cue = { track: number; at: number; duration: number; payload: string };
      const tracks = new Map<number, Track>();
      const cues: Cue[] = [];
      const decoder = new Decoder();
      let scale = 1_000_000;
      let clusterTime = 0;
      let currentTrack: Partial<Track> | null = null;
      let pendingGroup: { track: number; relative: number; payload: string; duration?: number } | null = null;
      let decoderError: unknown = null;
      decoder.on("error", (error: unknown) => {
        decoderError = error;
      });
      decoder.on("data", (entry: [string, Record<string, any>]) => {
        const [kind, tag] = entry;
        if (tag.name === "TrackEntry" && kind === "start") {
          currentTrack = {};
          return;
        }
        if (currentTrack) {
          if (tag.name === "TrackNumber") currentTrack.number = Number(tag.value);
          else if (tag.name === "TrackType") currentTrack.type = Number(tag.value);
          else if (tag.name === "CodecID") currentTrack.codec = textFromEbml(tag.value);
          else if (tag.name === "CodecPrivate") currentTrack.privateData = textFromEbml(tag.data);
          else if (tag.name === "Name") currentTrack.name = textFromEbml(tag.value);
          else if (tag.name === "Language") currentTrack.language = textFromEbml(tag.value);
          else if (tag.name === "FlagDefault") currentTrack.default = Boolean(tag.value);
          if (tag.name === "TrackEntry" && kind === "end" && currentTrack.number) {
            tracks.set(currentTrack.number, {
              number: currentTrack.number,
              type: currentTrack.type || 0,
              codec: currentTrack.codec || "",
              privateData: currentTrack.privateData || "",
              name: currentTrack.name || "",
              language: currentTrack.language || "",
              default: currentTrack.default !== false
            });
            currentTrack = null;
          }
          return;
        }
        if (tag.name === "TimecodeScale") scale = Number(tag.value) || scale;
        else if (tag.name === "Timecode") clusterTime = Number(tag.value) || 0;
        else if ((tag.name === "Block" || tag.name === "SimpleBlock") && kind === "tag") {
          pendingGroup = { track: Number(tag.track), relative: Number(tag.value) || 0, payload: textFromEbml(tag.payload) };
          if (tag.name === "SimpleBlock") {
            cues.push({ track: pendingGroup.track, at: (clusterTime + pendingGroup.relative) * scale / 1_000_000, duration: 0, payload: pendingGroup.payload });
            pendingGroup = null;
          }
        } else if (tag.name === "BlockDuration" && pendingGroup) {
          pendingGroup.duration = Number(tag.value) || 0;
        } else if (tag.name === "BlockGroup" && kind === "end" && pendingGroup) {
          cues.push({ track: pendingGroup.track, at: (clusterTime + pendingGroup.relative) * scale / 1_000_000, duration: (pendingGroup.duration || 0) * scale / 1_000_000, payload: pendingGroup.payload });
          pendingGroup = null;
        }
      });
      const reader = response.body.getReader();
      try {
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          if (!isCurrentItemLoad(request, route, signal)) return [];
          writeEbmlBytes(decoder, value);
          if (decoderError) throw decoderError;
        }
      } finally {
        reader.releaseLock();
      }
      decoder.end();
      if (decoderError) throw decoderError;

      const subtitleTracks = [...tracks.values()].filter((track) => track.type === 17 && /^S_TEXT\/ASS$/i.test(track.codec) && track.privateData);
      if (!subtitleTracks.length || !isCurrentItemLoad(request, route, signal)) return [];
      return subtitleTracks.slice(0, 1).map((track) => {
        const selected = cues.filter((cue) => cue.track === track.number).sort((a, b) => a.at - b.at);
        const events = selected.map((cue, cueIndex) => {
          const fields = cue.payload.split(",");
          if (fields.length < 9) return "";
          const end = cue.duration > 0 ? cue.at + cue.duration : selected[cueIndex + 1]?.at || cue.at + 3;
          return `Dialogue: ${fields[1]},${assTime(cue.at)},${assTime(end)},${fields.slice(2).join(",")}`;
        }).filter(Boolean);
        if (!events.length) return null;
        const script = track.privateData
          .replace(/^\uFEFF/, "")
          .replace(/\r\n?/g, "\n")
          .replace(/\n\[Events\][\s\S]*$/i, "")
          .trimEnd();
        return {
          value: `embedded:${track.number}`,
          label: track.name.trim() || track.language.trim() || "ASS",
          raw: `${script}\n\n[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n${events.join("\n")}`,
          isDefault: track.default
        };
      }).filter((track): track is EmbeddedSubtitle => Boolean(track));
    }

    async function loadExternalVideoSubtitle(item: MediaItem, signal: AbortSignal) {
      if (!item.sub) return "";
      const subUrl = `/api/public/sub?path=${encodeURIComponent(item.path)}`;
      const response = await fetch(subUrl, { signal });
      if (!response.ok) throw new Error("Subtitle request failed.");
      return response.text();
    }

    async function loadMoviExternalSubtitle(item: MediaItem, signal: AbortSignal) {
      if (!item.sub || !d.movi.player) return false;
      const raw = await loadExternalVideoSubtitle(item, signal);
      if (!raw.trim()) return false;
      const vtt = assToWebVtt(raw);
      const url = URL.createObjectURL(new Blob([vtt], { type: "text/vtt" }));
      if (s.moviExternalObjectUrl) URL.revokeObjectURL(s.moviExternalObjectUrl);
      s.moviExternalObjectUrl = url;
      s.moviExternalSubtitle = "external-ass";
      d.movi.player.addSubtitleTrack({ url, lang: s.moviExternalSubtitle, label: t("externalSubtitle"), format: "vtt" });
      return true;
    }

    async function loadPlaysVideo(item: MediaItem, request: number, route: number, signal: AbortSignal, shouldPlay: boolean) {
      const { PlaysVideoEngine: Engine } = await import("playsvideo");
      if (!isCurrentItemLoad(request, route, signal)) return false;
      const engine = new Engine(d.video, { embeddedSubtitlePolicy: "off" });
      s.playsVideoEngine = engine;
      s.playsVideoActive = true;
      const ready = new Promise<void>((resolve, reject) => {
        let settled = false;
        const cleanup = () => signal.removeEventListener("abort", onAbort);
        const finish = (callback: () => void) => {
          if (settled) return;
          settled = true;
          cleanup();
          callback();
        };
        const onAbort = () => finish(() => reject(new DOMException("Video loading was aborted.", "AbortError")));
        engine.addEventListener("ready", () => finish(resolve), { once: true });
        engine.addEventListener("error", (event) => finish(() => reject(new Error(event.detail.message))), { once: true });
        engine.addEventListener("subtitle-status", () => {
          if (!s.playsVideoActive) return;
          collectPlaysVideoTracks();
          renderSubtitleOptions();
          if (s.subtitleSelection.startsWith("embedded:")) applyPlaysVideoSubtitle(request, route, signal).catch(() => undefined);
        });
        signal.addEventListener("abort", onAbort, { once: true });
        try {
          engine.loadUrl(item.url!);
        } catch (error) {
          finish(() => reject(error));
        }
      });
      await ready;
      if (!isCurrentItemLoad(request, route, signal)) return false;
      collectPlaysVideoTracks();
      if (s.subtitleSelection === "off" && !s.externalSubtitleRaw && s.playsVideoTracks.length) {
        s.subtitleSelection = `embedded:${s.playsVideoTracks[0].id}`;
      }
      renderSubtitleOptions();
      await applySelectedVideoSubtitle(request, route, signal);
      return shouldPlay ? startVideoPlayback(request, route, signal) : true;
    }

    async function waitForVideoMetadata(media: HTMLVideoElement, signal: AbortSignal) {
      if (media.readyState >= HTMLMediaElement.HAVE_METADATA) return;
      await new Promise<void>((resolve, reject) => {
        let settled = false;
        const cleanup = () => {
          media.removeEventListener("loadedmetadata", onReady);
          media.removeEventListener("error", onError);
          signal.removeEventListener("abort", onAbort);
          window.clearTimeout(timeout);
        };
        const finish = (callback: () => void) => {
          if (settled) return;
          settled = true;
          cleanup();
          callback();
        };
        const onReady = () => finish(resolve);
        const onError = () => finish(() => reject(new Error(t("playFailed"))));
        const onAbort = () => finish(() => reject(new DOMException("Video loading was aborted.", "AbortError")));
        const timeout = window.setTimeout(onError, 90000);
        media.addEventListener("loadedmetadata", onReady, { once: true });
        media.addEventListener("error", onError, { once: true });
        signal.addEventListener("abort", onAbort, { once: true });
        if (media.readyState >= HTMLMediaElement.HAVE_METADATA) onReady();
      });
    }

    async function loadDefaultVideo(item: MediaItem, request: number, route: number, signal: AbortSignal, shouldPlay: boolean) {
      if (!item.url) throw new Error(t("playFailed"));
      s.videoBackend = "default";
      s.moviActive = false;
      s.playsVideoActive = false;
      s.playsVideoTracks = [];
      s.moviSubtitleTracks = [];
      s.moviExternalSubtitle = null;
      s.externalSubtitleRaw = null;
      s.nativeEmbeddedSubtitle = null;
      d.videoFrame.dataset.backend = "native";
      d.video.hidden = false;
      d.movi.hidden = true;
      d.vplayerHost.hidden = true;
      d.video.poster = item.poster || "/poster.svg";

      try {
        if (item.sub) s.externalSubtitleRaw = await loadExternalVideoSubtitle(item, signal);
        if (!s.externalSubtitleRaw?.trim()) {
          s.nativeEmbeddedSubtitle = (await parseEmbeddedVideoSubtitles(item, request, route, signal))[0] || null;
        }
      } catch {
        if (signal.aborted) throw new DOMException("Video loading was aborted.", "AbortError");
      }
      if (!isCurrentItemLoad(request, route, signal)) return false;
      s.subtitleSelection = s.externalSubtitleRaw?.trim()
        ? "external"
        : s.nativeEmbeddedSubtitle ? "embedded:0" : "off";
      d.video.src = item.url;
      d.video.load();
      renderSubtitleOptions();
      if (s.subtitleSelection !== "off") await applyDefaultSubtitle(request, route, signal);
      await waitForVideoMetadata(d.video, signal);
      return shouldPlay ? startVideoPlayback(request, route, signal) : true;
    }

    async function loadVPlayer(item: MediaItem, request: number, route: number, signal: AbortSignal, shouldPlay: boolean) {
      if (!item.url) throw new Error(t("playFailed"));
      const [reactDom, react, playerModule] = await Promise.all([
        import("react-dom/client"),
        import("react"),
        import("@vplayer/react"),
        import("@vplayer/react/player.css")
      ]).then(([dom, reactRuntime, player]) => [dom, reactRuntime, player] as const);
      if (!isCurrentItemLoad(request, route, signal)) return false;
      s.videoBackend = "vplayer";
      s.moviActive = false;
      s.playsVideoActive = false;
      s.playsVideoTracks = [];
      s.moviSubtitleTracks = [];
      s.moviExternalSubtitle = null;
      d.videoFrame.dataset.backend = "vplayer";
      d.video.hidden = true;
      d.movi.hidden = true;
      d.vplayerHost.hidden = false;

      let subtitleRaw = "";
      if (item.sub) {
        try {
          subtitleRaw = await loadExternalVideoSubtitle(item, signal);
        } catch (error) {
          if (signal.aborted) throw error;
          console.warn("Could not load external video subtitle for VPlayer.", error);
        }
      }
      if (!isCurrentItemLoad(request, route, signal)) return false;
      const subtitles = subtitleRaw.trim() ? [{
        id: "external-ass",
        content: assToWebVtt(subtitleRaw),
        lang: "zh",
        label: t("externalSubtitle"),
        format: "vtt",
        default: true
      }] : [];
      const root = reactDom.createRoot(d.vplayerHost);
      s.vplayerRoot = root;
      root.render(react.createElement(playerModule.VideoPlayer as any, {
        src: item.url,
        title: item.name,
        poster: item.poster || "/poster.svg",
        subtitles,
        embeddedTracks: true,
        autoPlay: false,
        defaultHotkeys: false,
        captionSettingsMenu: false,
        lang: s.lang === "zh" ? "zh-CN" : s.lang === "ja" ? "ja" : "en",
        captionSettings: {
          fontSize: "medium",
          fontScale: 92,
          fontFamily: "sans",
          textColor: "#CCFFFF",
          textOpacity: 1,
          backgroundColor: "#000000",
          backgroundOpacity: 0.3,
          edgeStyle: "shadow",
          edgeColor: "#000000",
          position: 2,
          lineHeight: 1.2,
          delay: 0
        }
      }));

      const waitForElement = async () => {
        for (let attempt = 0; attempt < 100; attempt += 1) {
          if (!isCurrentItemLoad(request, route, signal)) return null;
          const media = d.vplayerHost.querySelector("video");
          if (media) return media;
          await new Promise((resolve) => window.setTimeout(resolve, 20));
        }
        throw new Error(t("playFailed"));
      };
      const media = await waitForElement();
      if (!media) return false;
      s.vplayerVideo = media;
      bindVideoEvents(media);
      await waitForVideoMetadata(media, signal);
      if (!isCurrentItemLoad(request, route, signal)) return false;
      s.externalSubtitleRaw = subtitleRaw;
      s.moviExternalSubtitle = subtitleRaw.trim() ? "external-ass" : null;
      s.subtitleSelection = subtitleRaw.trim() ? "external" : "off";
      renderSubtitleOptions();
      return shouldPlay ? startVideoPlayback(request, route, signal) : true;
    }

    async function loadMoviVideo(item: MediaItem, request: number, route: number, signal: AbortSignal, backend: VideoBackend, shouldPlay = true) {
      if (!item.url) throw new Error(t("playFailed"));
      if (backend === "default") return loadDefaultVideo(item, request, route, signal, shouldPlay);
      if (backend === "vplayer") return loadVPlayer(item, request, route, signal, shouldPlay);
      if (backend === "playsvideo") {
        s.videoBackend = "playsvideo";
        s.moviActive = false;
        d.videoFrame.dataset.backend = "playsvideo";
        d.video.hidden = false;
        d.movi.hidden = true;
        d.vplayerHost.hidden = true;
        d.video.poster = item.poster || "/poster.svg";
        s.moviExternalSubtitle = null;
        s.externalSubtitleRaw = null;
        s.moviSubtitleTracks = [];
        s.playsVideoTracks = [];
        try {
          if (item.sub) s.externalSubtitleRaw = await loadExternalVideoSubtitle(item, signal);
        } catch (error) {
          if (signal.aborted) throw error;
          console.warn("Could not load external video subtitle for PlaysVideo.", error);
        }
        if (!isCurrentItemLoad(request, route, signal)) return false;
        s.moviExternalSubtitle = s.externalSubtitleRaw?.trim() ? "external-ass" : null;
        s.subtitleSelection = s.moviExternalSubtitle ? "external" : "off";
        renderSubtitleOptions();
        const ready = await loadPlaysVideo(item, request, route, signal, shouldPlay);
        return ready;
      }

      s.videoBackend = "movi";
      await import("movi-player/element");
      if (!isCurrentItemLoad(request, route, signal)) return false;
      s.moviActive = true;
      s.playsVideoActive = false;
      s.playsVideoTracks = [];
      s.nativeEmbeddedSubtitle = null;
      s.moviSubtitleTracks = [];
      s.moviSubtitleFonts = [];
      s.moviExternalSubtitle = null;
      s.externalSubtitleRaw = null;
      d.videoFrame.dataset.backend = "movi";
      d.video.hidden = true;
      d.movi.hidden = false;
      d.vplayerHost.hidden = true;
      installMoviSubtitleStyle();
      d.movi.poster = item.poster || "/poster.svg";

      const ready = new Promise<void>((resolve, reject) => {
        let settled = false;
        const cleanup = () => {
          d.movi.removeEventListener("loadedmetadata", onReady);
          d.movi.removeEventListener("canplay", onReady);
          d.movi.removeEventListener("error", onError);
          signal.removeEventListener("abort", onAbort);
        };
        const finish = (callback: () => void) => {
          if (settled) return;
          settled = true;
          cleanup();
          callback();
        };
        const onReady = () => finish(resolve);
        const onError = () => finish(() => reject(new Error(t("playFailed"))));
        const onAbort = () => finish(() => reject(new DOMException("Video loading was aborted.", "AbortError")));
        d.movi.addEventListener("loadedmetadata", onReady);
        d.movi.addEventListener("canplay", onReady);
        d.movi.addEventListener("error", onError);
        signal.addEventListener("abort", onAbort, { once: true });
        try {
          d.movi.src = item.url!;
          void d.movi.load().catch(onError);
        } catch (error) {
          finish(() => reject(error));
        }
      });
      await ready;
      if (!isCurrentItemLoad(request, route, signal)) return false;

      const player = d.movi.player;
      if (!player) throw new Error(t("playFailed"));
      s.moviSubtitleTracks = player.getSubtitleTracks().slice();
      if (s.moviSubtitleTracks.some(isAssMoviTrack)) {
        try {
          s.moviSubtitleFonts = await extractMkvFonts(item.url, signal);
        } catch (error) {
          if (signal.aborted) throw error;
          console.warn("Could not read embedded MKV font attachments; using the subtitle fallback font.", error);
        }
      }
      if (!isCurrentItemLoad(request, route, signal)) return false;
      try {
        if (item.sub) await loadMoviExternalSubtitle(item, signal);
      } catch {
        console.warn(`Could not load external video subtitle for ${backend}.`);
      }
      if (!isCurrentItemLoad(request, route, signal)) return false;
      if (s.moviExternalSubtitle) {
        s.subtitleSelection = "external";
      } else {
        s.subtitleSelection = s.moviSubtitleTracks[0] ? `embedded:${s.moviSubtitleTracks[0].id}` : "off";
      }
      renderSubtitleOptions();
      await applySelectedVideoSubtitle(request, route, signal);
      return shouldPlay ? startVideoPlayback(request, route, signal) : true;
    }

    d.video.textTracks.addEventListener("addtrack", () => {
      if (!s.playsVideoActive) return;
      collectPlaysVideoTracks();
      if (s.subtitleSelection === "off" && s.playsVideoTracks.length) {
        s.subtitleSelection = `embedded:${s.playsVideoTracks[0].id}`;
      }
      renderSubtitleOptions();
      if (s.subtitleSelection.startsWith("embedded:") && subtitleAbortController) {
        applyPlaysVideoSubtitle(itemRequest, routeRequest, subtitleAbortController.signal).catch(() => undefined);
      }
    });

    d.movi.addEventListener("trackschange", () => {
      if (!s.moviActive || !s.current?.embeddedMulti || !d.movi.player) return;
      const tracks = d.movi.player.getSubtitleTracks().slice();
      const changed = tracks.length !== s.moviSubtitleTracks.length || tracks.some((track, index) => track.id !== s.moviSubtitleTracks[index]?.id);
      if (!changed) return;
      s.moviSubtitleTracks = tracks;
      const shouldSelectFirst = s.subtitleSelection === "off" && !s.moviExternalSubtitle && tracks.length > 0;
      if (shouldSelectFirst) s.subtitleSelection = `embedded:${tracks[0].id}`;
      renderSubtitleOptions();
      if (shouldSelectFirst && subtitleAbortController) {
        applyMoviSubtitle(itemRequest, routeRequest, subtitleAbortController.signal).catch(() => undefined);
      }
    });

    async function changeVideoSubtitle(value: string) {
      if (!s.current?.embeddedMulti || s.current.kind !== "video" || s.videoBackend !== "movi") return;
      const selection: SubtitleSelection = value === "external" || value === "off" || value.startsWith("embedded:")
        ? value as SubtitleSelection
        : "off";
      const request = itemRequest;
      const route = routeRequest;
      const signal = subtitleAbortController?.signal;
      if (!signal) return;
      s.subtitleSelection = selection;
      renderSubtitleOptions();
      try {
        await applySelectedVideoSubtitle(request, route, signal);
        if (isCurrentItemLoad(request, route, signal)) setStatus(d.playerStatus, t("playing"));
      } catch (error) {
        if (isCurrentItemLoad(request, route, signal)) {
          s.subtitleSelection = "off";
          renderSubtitleOptions();
          setStatus(d.playerStatus, error instanceof Error ? error.message : t("subFailed"), "error");
        }
      }
    }

    async function changeVideoBackend(value: string) {
      if (!s.current?.embeddedMulti || s.current.h5Player !== "select") return;
      const backend: VideoBackend = value === "playsvideo" || value === "movi" || value === "vplayer" ? value : "default";
      if (backend === s.videoBackend) return;
      const item = s.current;
      const previousMedia = activeVideo();
      const shouldPlay = !previousMedia.paused;
      saveProgress(true);
      const request = itemRequest;
      const route = routeRequest;
      subtitleAbortController?.abort();
      const controller = new AbortController();
      subtitleAbortController = controller;
      const signal = controller.signal;

      await destroyVideoSubtitle();
      destroyPlaysVideo();
      destroyMoviVideo();
      destroyVPlayer();
      d.video.pause();
      d.video.removeAttribute("src");
      d.video.load();
      s.videoBackend = backend;
      s.playsVideoTracks = [];
      s.nativeEmbeddedSubtitle = null;
      s.moviSubtitleTracks = [];
      s.moviExternalSubtitle = null;
      s.externalSubtitleRaw = null;
      s.subtitleSelection = "off";
      renderSubtitleOptions();
      try {
        await loadMoviVideo(item, request, route, signal, backend, shouldPlay);
      } catch (error) {
        if (isCurrentItemLoad(request, route, signal)) {
          setStatus(d.playerStatus, error instanceof Error ? error.message : t("playFailed"), "error");
        }
      }
    }

    async function startVideoPlayback(request: number, route: number, signal: AbortSignal) {
      if (!isCurrentItemLoad(request, route, signal)) return false;
      try {
        await activeVideo().play();
        return true;
      } catch {
        if (isCurrentItemLoad(request, route, signal)) setStatus(d.playerStatus, t("playFailed"), "error");
        return false;
      }
    }

    async function openItem(path: string, navigation: NavigationMode = "push", prefetched?: ItemPayload) {
      itemAbortController?.abort();
      subtitleAbortController?.abort();
      if (navigation !== "none") {
        routeRequest += 1;
        setStatus(d.libraryStatus);
      }
      const route = routeRequest;
      const request = ++itemRequest;
      const itemController = new AbortController();
      itemAbortController = itemController;
      setStatus(d.playerStatus, t("loading"));
      d.stage.dataset.signal = "transfer";
      let data: ItemPayload | null;
      try {
        data = prefetched || await requestItem(path, false, itemController.signal);
      } catch (error) {
        if (!isCurrentItemLoad(request, route, itemController.signal)) return;
        throw error;
      }
      if (!isCurrentItemLoad(request, route, itemController.signal) || !data) return;
      const item: MediaItem = data.item;
      const audioQueue = s.items.filter((entry) => !entry.isDir && entry.kind === "audio");
      const videoQueue = s.items.filter((entry) => !entry.isDir && entry.kind === "video");
      await clearMedia();
      if (!isCurrentItemLoad(request, route, itemController.signal)) return;
      s.current = item;
      s.videoBackend = item.embeddedMulti
        ? item.h5Player === "select" ? "default" : item.h5Player || "movi"
        : "default";
      s.subtitleSelection = item.embeddedMulti
        ? item.sub ? "external" : "off"
        : "off";
      s.moviSubtitleTracks = [];
      resetStatSession(data.stat || { plays: 0, completions: 0, rate: 0 });
      if (item.kind === "audio" && !s.audioQueue.some((entry) => entry.path === item.path)) s.audioQueue = audioQueue;
      if (item.kind === "video" && !s.videoQueue.some((entry) => entry.path === item.path)) s.videoQueue = videoQueue;
      renderCurrent();
      render();
      updateVisitorUrl(item.path, navigation);
      trackVisitor("media", item.path);

      let videoPlaybackStarted = false;
      if (item.kind === "image") {
        d.stage.dataset.mode = "image";
        d.imageFrame.hidden = false;
        d.image.src = item.url || "";
        d.image.alt = item.name;
        recordStat("play");
      } else if (item.kind === "file") {
        d.stage.dataset.mode = "file";
        delete d.stage.dataset.signal;
        d.fileFrame.hidden = false;
        d.fileDescription.innerHTML = renderMarkdown(item.description || "");
        d.fileDownload.href = item.url || "#";
        d.fileDownload.download = item.name;
        setStatus(d.playerStatus);
      } else if (item.kind === "audio") {
        d.stage.dataset.mode = "audio";
        d.audioFrame.hidden = false;
        d.audioPoster.dataset.posterStage = item.poster ? "custom" : "embedded";
        d.audioPoster.dataset.coverUrl = publicCoverPath(item.path);
        d.audioPoster.src = item.poster || d.audioPoster.dataset.coverUrl;
        d.audioPoster.alt = item.name;
        d.audioTitle.textContent = item.name;
        d.audioPath.textContent = item.artist || displayPath(item.path);
        d.audio.src = item.url || "";
        d.audio.load();
        updateAudioControls();
        if (item.lrc || item.lrc2) loadLyrics(item).catch(() => setLyricsState("lyricsFailed"));
        d.audio.play().catch(() => undefined);
      } else {
        d.stage.dataset.mode = "video";
        d.videoFrame.hidden = false;
        d.video.hidden = false;
        d.movi.hidden = true;
        d.videoFrame.dataset.backend = "native";
        d.video.poster = item.poster || "/poster.svg";
        d.video.preload = "auto";
        updateVideoControls();
        showControls();
        subtitleAbortController?.abort();
        const subtitleController = new AbortController();
        subtitleAbortController = subtitleController;
        if (item.embeddedMulti) {
          try {
            videoPlaybackStarted = await loadMoviVideo(item, request, route, subtitleController.signal, s.videoBackend);
          } catch (error) {
            if (isCurrentItemLoad(request, route, subtitleController.signal)) {
              setStatus(d.playerStatus, error instanceof Error ? error.message : t("playFailed"), "error");
            }
          }
        } else {
          s.videoBackend = "default";
          d.video.src = item.url || "";
          d.video.load();
          let embedded: EmbeddedSubtitle | undefined;
          let rawSubtitle = "";
          try {
            if (!item.sub) {
              embedded = (await parseEmbeddedVideoSubtitles(item, request, route, subtitleController.signal))[0];
            }
          } catch (error) {
            // Embedded subtitles are optional; the video remains playable if parsing fails.
            console.warn("Could not scan embedded video subtitles.", error);
          }
          if (!isCurrentItemLoad(request, route, subtitleController.signal)) return;
          if (item.sub) {
            try {
              rawSubtitle = await loadExternalVideoSubtitle(item, subtitleController.signal);
            } catch {
              console.warn("Could not load external video subtitle.");
            }
            if (!rawSubtitle.trim()) {
              try {
                embedded = (await parseEmbeddedVideoSubtitles(item, request, route, subtitleController.signal))[0];
              } catch (error) {
                console.warn("Could not scan embedded video subtitles.", error);
              }
            }
          }
          rawSubtitle = rawSubtitle.trim() || embedded?.raw || "";
          if (!isCurrentItemLoad(request, route, subtitleController.signal)) return;
          if (rawSubtitle) {
            try {
              await installVideoSubtitle(rawSubtitle, request, route, subtitleController.signal);
              d.subtitle.hidden = false;
              d.subtitleText.textContent = "ASS";
            } catch {
              d.videoFrame.dataset.subtitleReady = "0";
              d.subtitle.hidden = true;
              d.subtitleText.textContent = "";
            }
          } else {
            d.subtitle.hidden = true;
            d.subtitleText.textContent = "";
          }
          videoPlaybackStarted = await startVideoPlayback(request, route, subtitleController.signal);
        }
      }
      if (!d.playerStatus.dataset.tone && (item.kind !== "video" || videoPlaybackStarted)) setStatus(d.playerStatus, t("playing"));
    }

    d.list.addEventListener("click", (event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>("[data-path]");
      if (!row?.dataset.path) return;
      if (row.dataset.dir !== "1") setLibraryOpen(false);
      if (row.dataset.dir === "1") clearSearch();
      const action = row.dataset.dir === "1" ? load(row.dataset.path, "", "push") : openItem(row.dataset.path, "push");
      action.catch((error) => {
        if (row.dataset.dir !== "1") d.stage.dataset.signal = "interrupted";
        setStatus(row.dataset.dir === "1" ? d.libraryStatus : d.playerStatus, error.message, "error");
      });
    });

    d.parent.addEventListener("click", () => {
      const parent = s.path.split("/").filter(Boolean).slice(0, -1).join("/");
      clearSearch();
      load(parent ? `/${parent}` : "/root", "", "push").catch((error) => setStatus(d.libraryStatus, error.message, "error"));
    });
    d.refresh.addEventListener("click", () => load().catch((error) => setStatus(d.libraryStatus, error.message, "error")));
    d.search.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      const query = d.search.value.trim();
      searchTimer = window.setTimeout(() => {
        load(s.path, query).catch((error) => setStatus(d.libraryStatus, error.message, "error"));
      }, 220);
    });
    d.libraryToggle.addEventListener("click", () => setLibraryOpen(!d.app.classList.contains("is-library-open")));
    d.libraryScrim.addEventListener("click", () => setLibraryOpen(false));
    let librarySwipeStart: { x: number; y: number } | null = null;
    document.addEventListener("pointerdown", (event) => {
      if (!isMobileLibraryAvailable()) return;
      if (event.clientX <= 24 || d.app.classList.contains("is-library-open")) {
        librarySwipeStart = { x: event.clientX, y: event.clientY };
      }
    });
    document.addEventListener("pointerup", (event) => {
      if (!librarySwipeStart) return;
      const start = librarySwipeStart;
      librarySwipeStart = null;
      const deltaX = event.clientX - start.x;
      const deltaY = event.clientY - start.y;
      if (Math.abs(deltaX) < 60 || Math.abs(deltaX) < Math.abs(deltaY) * 1.25) return;
      if (deltaX > 0 && start.x <= 24) setLibraryOpen(true);
      if (deltaX < 0 && d.app.classList.contains("is-library-open")) setLibraryOpen(false);
    });
    document.addEventListener("pointercancel", () => {
      librarySwipeStart = null;
    });
    libraryMedia.addEventListener("change", () => setLibraryOpen(d.app.classList.contains("is-library-open")));
    touchMedia.addEventListener("change", () => setLibraryOpen(d.app.classList.contains("is-library-open")));
    d.audio.addEventListener("timeupdate", () => {
      syncLyrics();
      updateAudioControls();
      saveProgress();
      recordProgress(d.audio);
    });
    d.audio.addEventListener("seeked", () => {
      syncLyrics(true);
      saveProgress(true);
    });
    ["play", "pause", "durationchange", "loadedmetadata", "volumechange"].forEach((event) => {
      d.audio.addEventListener(event, updateAudioControls);
    });
    d.audio.addEventListener("play", () => {
      delete d.stage.dataset.signal;
      recordPlay();
      startLyricFrame();
    });
    d.audio.addEventListener("loadedmetadata", () => restoreProgress(d.audio));
    d.audio.addEventListener("pause", () => {
      stopLyricFrame();
      saveProgress(true);
    });
    ["waiting", "stalled"].forEach((event) => {
      d.audio.addEventListener(event, () => {
        d.stage.dataset.signal = "unstable";
        setStatus(d.playerStatus, t("buffering"));
      });
    });
    ["canplay", "playing"].forEach((event) => {
      d.audio.addEventListener(event, () => {
        delete d.stage.dataset.signal;
        if (s.current?.kind === "audio") setStatus(d.playerStatus, t("playing"));
      });
    });
    d.audio.addEventListener("error", () => {
      d.stage.dataset.signal = "interrupted";
    });
    d.image.addEventListener("load", () => {
      delete d.stage.dataset.signal;
    });
    d.image.addEventListener("error", () => {
      d.stage.dataset.signal = "interrupted";
    });
    d.audio.addEventListener("ended", async () => {
      saveProgress(true, true);
      updateAudioControls();
      await recordStat("complete");
      continueAudio().catch((error) => setStatus(d.playerStatus, error.message, "error"));
    });
    d.audioPlayToggle.addEventListener("click", toggleAudioPlay);
    d.audioPrevious.addEventListener("click", () => playAdjacent("audio", -1).catch((error) => setStatus(d.playerStatus, error.message, "error")));
    d.audioNext.addEventListener("click", () => playAdjacent("audio", 1).catch((error) => setStatus(d.playerStatus, error.message, "error")));
    d.audioModeToggle.addEventListener("click", cycleAudioMode);
    d.audioMuteToggle.addEventListener("click", () => {
      d.audio.muted = !d.audio.muted;
      if (!d.audio.muted && d.audio.volume === 0) d.audio.volume = 1;
    });
    d.audioSeek.addEventListener("pointerdown", () => {
      audioSeeking = true;
    });
    d.audioSeek.addEventListener("input", () => {
      d.audio.currentTime = Number(d.audioSeek.value);
      updateAudioControls();
      syncLyrics(true);
    });
    d.audioSeek.addEventListener("change", () => {
      audioSeeking = false;
      updateAudioControls();
    });
    d.audioVolume.addEventListener("input", () => {
      d.audio.muted = false;
      d.audio.volume = Number(d.audioVolume.value);
    });
    d.audioPoster.addEventListener("error", () => {
      if (d.audioPoster.dataset.posterStage === "custom") {
        d.audioPoster.dataset.posterStage = "embedded";

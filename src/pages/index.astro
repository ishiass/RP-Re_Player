    function handleVideoEvent(media: VideoMedia, event: string) {
      if (activeVideo() !== media || s.current?.kind !== "video") return;
      const controlsHidden = d.videoFrame.classList.contains("controls-hidden");
      updateVideoControls();
      if (event === "timeupdate") {
        saveProgress();
        recordProgress(media);
      }
      if (event === "seeked") saveProgress(true);
      if (event === "play") {

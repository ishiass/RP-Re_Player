---
import SiteShell from "../../layouts/SiteShell.astro";
import { getEnv } from "@lib/cloudflare";
import { getItem, publicMediaPath } from "@lib/pseudo";
import { recordVisitorEvent } from "@lib/visitor-events";

const pathname = Astro.url.pathname;
const prefix = pathname.startsWith("/Action") ? "/Action" : "/action";
const relative = pathname.slice(prefix.length).replace(/^\/+|\/+$/g, "");
let item = null;
try {
  const parts = relative ? relative.split("/").map((part) => decodeURIComponent(part)) : [];
  if (parts.length && parts.every((part) => part && part !== "." && part !== ".." && !/[\\/\u0000-\u001f\u007f]/.test(part))) {
    item = await getItem(await getEnv(Astro), `/root/action/${parts.join("/")}`);
  }
} catch {
  item = null;
}
const env = await getEnv(Astro);
// Await the write so direct Action visits are reliably visible in the visitor table.
if (item) await recordVisitorEvent(env, Astro.request, "media", item.path);
const mediaUrl = item ? publicMediaPath(item.path) : "";
---

<SiteShell title={item?.name || "Action - Re-Player"}>
  <main class="action-media-page">
    {item ? (
      item.kind === "audio" ? <audio src={mediaUrl} controls autoplay preload="auto" /> : item.kind === "image" ? <img src={mediaUrl} alt={item.name} /> : <video src={mediaUrl} controls autoplay playsinline preload="auto" />
    ) : <p>Media not found.</p>}
  </main>
  <style>
    :global(html), :global(body) { min-width: 0; min-height: 100%; margin: 0; background: #000; }
    .action-media-page { min-height: 100vh; min-height: 100dvh; display: grid; place-items: center; overflow: hidden; background: #000; }
    .action-media-page video, .action-media-page audio { display: block; width: min(100vw, 100%); max-width: 100vw; max-height: 100vh; }
    .action-media-page img { display: block; max-width: 100vw; max-height: 100vh; width: auto; height: auto; object-fit: contain; }
    .action-media-page p { color: #fff; font: 16px/1.5 system-ui, sans-serif; }
  </style>
</SiteShell>

---
import {
  ChevronDown,
  File,
  FileImage,
  Film,
  Folder,
  FolderRoot,
  Languages,
  LogOut,
  Music2,
  Palette,
  Plus,
  RefreshCw,
  Trash2,
  X
} from "@lucide/astro";
import SiteShell from "../layouts/SiteShell.astro";
import { getEnv } from "@lib/cloudflare";
import { isAdmin } from "@lib/admin";

const env = await getEnv(Astro);
const loggedIn = await isAdmin(Astro.request, env);
---

<SiteShell title="Admin - Re Player">
  {
    !loggedIn ? (
      <main class="login-screen">
        <label class="language-box login-language">
          <Languages size={18} aria-hidden="true" />
          <span class="sr-only" data-i18n="language">Language</span>
          <select class="language-select" aria-label="Language">
            <option value="en">English</option>
            <option value="zh">简体中文</option>
            <option value="ja">日本語</option>
          </select>
        </label>

        <section class="login-panel">
          <div class="login-brand" aria-label="Re Player">
            <span class="app-brand-mark">RP</span>
            <span>
              <strong>Re Player</strong>
              <small data-i18n="console">Admin console</small>
            </span>
          </div>
          <h1 data-i18n="signIn">Sign in</h1>
          <p data-i18n="signInCopy">Enter the administrator password to continue.</p>
          <form id="loginForm" class="login-form">
            <label class="field">
              <span data-i18n="password">Password</span>
              <input name="password" type="password" autocomplete="current-password" required autofocus />
            </label>
            <button class="primary-button" type="submit" data-i18n="signIn">Sign in</button>
            <div id="loginStatus" class="form-status" role="status"></div>
          </form>
        </section>
      </main>
    ) : (
      <div class="admin-app">
        <header class="admin-topbar">
          <div class="app-brand" aria-label="Re Player">
            <span class="app-brand-mark">RP</span>
            <span>
              <strong>Re Player</strong>
              <small data-i18n="console">Admin console</small>
            </span>
          </div>
          <div class="admin-topbar-actions">
            <button id="mobileAdminTreeToggle" class="icon-button mobile-admin-tree-toggle" type="button" aria-label="Open storage" aria-controls="adminSidebar" aria-expanded="false"><Folder size={18} /></button>
            <button id="visitorThemeBtn" class="admin-theme-toggle" type="button" title="Visitor theme">
              <Palette size={16} aria-hidden="true" />
              <span id="visitorThemeLabel">Visitor theme: Default</span>
            </button>
            <label class="language-box">
              <Languages size={18} aria-hidden="true" />
              <span class="sr-only" data-i18n="language">Language</span>
              <select class="language-select" aria-label="Language">
                <option value="en">English</option>
                <option value="zh">简体中文</option>
                <option value="ja">日本語</option>
              </select>
            </label>
            <button id="logoutBtn" class="icon-button" type="button" title="Sign out" data-i18n-title="signOut">
              <LogOut size={18} />
              <span class="sr-only" data-i18n="signOut">Sign out</span>
            </button>
          </div>
        </header>

        <div class="admin-shell">
          <aside id="adminSidebar" class="admin-sidebar">
            <p class="admin-nav-label" data-i18n="storage">Storage</p>
            <nav id="adminTree" class="admin-tree" aria-label="Storage"></nav>
          </aside>

          <main class="admin-main">
            <div class="admin-page-heading">
              <div>
                <p class="section-kicker" data-i18n="pseudoMounts">Pseudo mounts</p>
                <h1 data-i18n="mediaFiles">Media files</h1>
                <p data-i18n="pageCopy">Manage public media links and optional ASS subtitles.</p>
              </div>
              <button id="addBtn" class="primary-button" type="button">
                <Plus size={17} />
                <span data-i18n="addFile">Add file</span>
              </button>
            </div>

            <section class="table-surface">
              <div class="table-toolbar">
                <strong id="mountCount">0 items</strong>
                <div class="toolbar-actions">
                  <span id="adminStatus" class="form-status" role="status"></span>
                  <button id="refreshLinks" class="icon-button" type="button" title="Refresh" data-i18n-title="refresh">
                    <RefreshCw size={18} />
                    <span class="sr-only" data-i18n="refresh">Refresh</span>
                  </button>
                </div>
              </div>
              <div class="table-scroll">
                <table class="mount-table">
                  <thead>
                    <tr>
                      <th data-i18n="name">Name</th>
                      <th data-i18n="path">Path</th>
                      <th data-i18n="type">Type</th>
                      <th data-i18n="subtitle">Subtitle</th>
                      <th data-i18n="source">Source</th>
                      <th><span class="sr-only" data-i18n="actions">Actions</span></th>
                    </tr>
                  </thead>
                  <tbody id="linkRows">
                    <tr><td class="empty-row" colspan="6" data-i18n="loading">Loading...</td></tr>
                  </tbody>
                </table>
              </div>
            </section>
          </main>
        </div>

        <dialog id="mountDialog" class="form-dialog">
          <div class="dialog-heading">
            <h2 data-i18n="addMount">Add pseudo mount</h2>
            <button class="icon-button" type="button" data-close title="Close" data-i18n-title="close">
              <X size={19} />
              <span class="sr-only" data-i18n="close">Close</span>
            </button>
          </div>
          <form id="linkForm" class="mount-form">
            <div class="form-row">
              <label class="field">
                <span data-i18n="folder">Folder</span>
                <input name="folder" type="text" value="/" autocomplete="off" required />
              </label>
              <label class="field">
                <span data-i18n="name">Name</span>
                <input name="name" type="text" placeholder="movie.mp4" autocomplete="off" required />
              </label>
            </div>
            <div class="form-row">
              <label class="field">
                <span data-i18n="type">Type</span>
                <select id="kindSelect" name="kind">
                  <option value="video" data-i18n="video">Video</option>
                  <option value="audio" data-i18n="audio">Audio</option>
                  <option value="image" data-i18n="image">Image</option>
                  <option value="file" data-i18n="file">File</option>
                </select>
              </label>
              <label id="posterField" class="field">
                <span data-i18n="posterUrl">Poster URL</span>
                <input name="poster" type="url" placeholder="https://example.com/poster.jpg" autocomplete="off" />
              </label>
            </div>
            <label class="field">
              <span id="urlLabel" data-i18n="mediaUrl">Media URL</span>
              <textarea name="url" required placeholder="https://example.com/video.mp4"></textarea>
            </label>
            <label id="descriptionField" class="field" hidden>
              <span data-i18n="description">Description</span>
              <textarea name="description" class="large-textarea" placeholder="Markdown is supported."></textarea>
            </label>
            <label id="subField" class="field">
              <span data-i18n="assUrl">ASS subtitle URL</span>
              <input name="sub" type="url" placeholder="https://example.com/subtitle.ass" autocomplete="off" />
            </label>
            <div id="lrcFields" class="lyrics-fields" hidden>
              <label class="field">
                <span data-i18n="lrcUrl">Lyrics URL</span>
                <input name="lrc" type="url" placeholder="https://example.com/lyrics.lrc" autocomplete="off" />
              </label>
              <label class="toggle-field">
                <input id="bilingualToggle" name="bi" type="checkbox" value="1" />
                <span class="toggle-track" aria-hidden="true"><span></span></span>
                <span data-i18n="bilingual">Bilingual lyrics</span>
              </label>
              <label id="lrc2Field" class="field" hidden>
                <span data-i18n="otherLrcUrl">Other-language lyrics URL</span>
                <input name="lrc2" type="url" placeholder="https://example.com/other-language.lrc" autocomplete="off" />
              </label>
            </div>
            <div id="formStatus" class="form-status" role="status"></div>
            <div class="dialog-actions">
              <button class="secondary-button" type="button" data-close data-i18n="cancel">Cancel</button>
              <button class="primary-button" type="submit" data-i18n="create">Create</button>
            </div>
          </form>
        </dialog>

        <template id="tableVideo"><Film size={18} /></template>
        <template id="tableAudio"><Music2 size={18} /></template>
        <template id="tableImage"><FileImage size={18} /></template>
        <template id="tableFile"><File size={18} /></template>
        <template id="tableTrash"><Trash2 size={16} /></template>
        <template id="treeRoot"><FolderRoot size={18} /></template>
        <template id="treeFolder"><Folder size={17} /></template>
        <template id="treeChevron"><ChevronDown size={15} /></template>
      </div>
    )
  }

  <script>
    const c = {
      en: {
        language: "Language", console: "Admin console", signIn: "Sign in", signInCopy: "Enter the administrator password to continue.",
        password: "Password", signOut: "Sign out", storage: "Storage", rootDirectory: "Root directory", mediaFiles: "Media files", pseudoMounts: "Pseudo mounts",
        pageCopy: "Manage public media links, subtitles, and lyrics.", addFile: "Add file", refresh: "Refresh",
        name: "Name", path: "Path", type: "Type", subtitle: "Subtitles / Lyrics", source: "Source", actions: "Actions",
        loading: "Loading...", addMount: "Add pseudo mount", close: "Close", folder: "Folder", video: "Video",
        audio: "Audio", image: "Image", file: "File", posterUrl: "Poster URL", mediaUrl: "Media URL", url: "URL", assUrl: "ASS subtitle URL",
        lrcUrl: "Lyrics URL", bilingual: "Bilingual lyrics", otherLrcUrl: "Other-language lyrics URL", description: "Description",
        cancel: "Cancel", create: "Create", empty: "No pseudo mounts yet", item: "item", items: "items",
        wrongPassword: "Incorrect password.", signingIn: "Signing in...", loadFailed: "Could not load pseudo mounts.",
        createFailed: "Could not create the pseudo mount.", created: "Pseudo mount created.", delete: "Delete",
        deleteConfirm: "Delete this pseudo mount?", deleteFailed: "Could not delete the pseudo mount.",
        visitorTheme: "Visitor theme", themeChanged: "Visitor theme switched", themeFailed: "Could not switch visitor theme."
      },
      zh: {
        language: "语言", console: "管理后台", signIn: "登录", signInCopy: "请输入管理员密码以继续。", password: "密码",
        signOut: "退出登录", storage: "存储", rootDirectory: "根目录", mediaFiles: "媒体文件", pseudoMounts: "伪挂载", pageCopy: "管理公开媒体链接、字幕及歌词。",
        addFile: "添加文件", refresh: "刷新", name: "文件名", path: "路径", type: "类型", subtitle: "字幕 / 歌词",
        source: "源链接", actions: "操作", loading: "正在加载...", addMount: "添加伪挂载", close: "关闭",
        folder: "目录", video: "视频", audio: "音频", image: "图片", file: "文件", posterUrl: "封面链接", mediaUrl: "媒体链接", url: "链接",
        assUrl: "ASS 字幕链接", lrcUrl: "歌词链接", bilingual: "是否双语", otherLrcUrl: "另一语言歌词链接", description: "说明",
        cancel: "取消", create: "创建", empty: "暂无伪挂载", item: "项", items: "项",
        wrongPassword: "密码错误。", signingIn: "正在登录...", loadFailed: "无法读取伪挂载。",
        createFailed: "无法创建伪挂载。", created: "伪挂载已创建。", delete: "删除", deleteConfirm: "删除此伪挂载？",
        deleteFailed: "无法删除此伪挂载。", visitorTheme: "访客主题", themeChanged: "访客主题已切换", themeFailed: "无法切换访客主题。"
      },
      ja: {
        language: "言語", console: "管理コンソール", signIn: "ログイン", signInCopy: "管理者パスワードを入力してください。",
        password: "パスワード", signOut: "ログアウト", storage: "ストレージ", rootDirectory: "ルートディレクトリ", mediaFiles: "メディアファイル", pseudoMounts: "疑似マウント",
        pageCopy: "公開メディアリンク、字幕、歌詞を管理します。", addFile: "ファイルを追加", refresh: "更新",
        name: "名前", path: "パス", type: "種類", subtitle: "字幕 / 歌詞", source: "元リンク", actions: "操作",
        loading: "読み込み中...", addMount: "疑似マウントを追加", close: "閉じる", folder: "フォルダー",
        video: "動画", audio: "音声", image: "画像", file: "ファイル", posterUrl: "ポスターURL", mediaUrl: "メディアURL", url: "リンク",
        assUrl: "ASS字幕URL", lrcUrl: "歌詞URL", bilingual: "二言語歌詞", otherLrcUrl: "別言語の歌詞URL", description: "説明",
        cancel: "キャンセル", create: "作成", empty: "疑似マウントはありません", item: "件",
        items: "件", wrongPassword: "パスワードが正しくありません。", signingIn: "ログイン中...",
        loadFailed: "疑似マウントを読み込めませんでした。", createFailed: "疑似マウントを作成できませんでした。",
        created: "疑似マウントを作成しました。", delete: "削除", deleteConfirm: "この疑似マウントを削除しますか？",
        deleteFailed: "疑似マウントを削除できませんでした。", visitorTheme: "ビジターテーマ", themeChanged: "ビジターテーマを切り替えました", themeFailed: "ビジターテーマを切り替えられませんでした。"
      }
    } as const;

    type Lang = keyof typeof c;
    type Item = { id: string; name: string; path: string; url: string; kind: "video" | "audio" | "image" | "file"; description?: string; poster?: string; sub?: string; lrc?: string; lrc2?: string };
    type VisitorTheme = "blue" | "retro" | "future" | "tech" | "gray";
    let lang: Lang = "en";
    let items: Item[] = [];
    let currentFolder = "/root";
    let visitorTheme: VisitorTheme = "blue";
    const collapsedFolders = new Set<string>();
    const themeNames: Record<Lang, Record<VisitorTheme, string>> = {
      en: { blue: "Default", retro: "Retro", future: "Azure", tech: "New Blue", gray: "Light Gray" },
      zh: { blue: "默认", retro: "复古", future: "蔚蓝", tech: "新蓝", gray: "浅灰" },
      ja: { blue: "デフォルト", retro: "レトロ", future: "アズール", tech: "ニューブルー", gray: "ライトグレー" }
    };
    const e: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
    const esc = (v: unknown) => String(v ?? "").replace(/[&<>"']/g, (x) => e[x]);
    const displayPath = (path: string) => path.replace(/^\/root(?=\/|$)/, "") || "/";
    const t = (k: keyof (typeof c)["en"]) => c[lang][k];
    const folderOf = (path: string) => path.slice(0, path.lastIndexOf("/")) || "/root";
    const folderName = (path: string) => path.split("/").filter(Boolean).pop() || "root";
    const shortFolderName = (path: string) => {
      const characters = [...folderName(path)];
      return characters.length > 7 ? `${characters.slice(0, 7).join("")}---` : characters.join("");
    };
    const isInsideFolder = (itemPath: string, folder: string) => {
      const base = (folder || "/root").replace(/\/+$/, "") || "/root";
      return itemPath === base || itemPath.startsWith(`${base}/`);
    };
    const set = (el: HTMLElement | null, message = "", tone = "") => {
      if (!el) return;
      el.textContent = message;
      tone ? (el.dataset.tone = tone) : delete el.dataset.tone;
    };

    function renderThemeControl() {
      const button = document.querySelector<HTMLButtonElement>("#visitorThemeBtn");
      const label = document.querySelector<HTMLElement>("#visitorThemeLabel");
      if (!button || !label) return;
      const value = `${t("visitorTheme")}: ${themeNames[lang][visitorTheme]}`;
      label.textContent = value;
      button.title = value;
    }

    function applyLanguage() {
      document.documentElement.lang = lang === "zh" ? "zh-CN" : lang === "ja" ? "ja" : "en";
      document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
        const key = el.dataset.i18n as keyof (typeof c)["en"];
        if (key && c[lang][key]) el.textContent = t(key);
      });
      document.querySelectorAll<HTMLElement>("[data-i18n-title]").forEach((el) => {
        const key = el.dataset.i18nTitle as keyof (typeof c)["en"];
        if (key && c[lang][key]) el.title = t(key);
      });
      document.querySelectorAll(".language-select").forEach((el) => ((el as unknown as HTMLSelectElement).value = lang));
      renderTree();
      renderRows();
      renderThemeControl();
    }

    function typeIcon(kind: Item["kind"]) {
      const id = kind === "audio" ? "tableAudio" : kind === "image" ? "tableImage" : kind === "file" ? "tableFile" : "tableVideo";
      return document.querySelector<HTMLTemplateElement>(`#${id}`)?.innerHTML || "";
    }

    function directoryPaths() {
      const paths = new Set<string>(["/root"]);
      items.forEach((item) => {
        const parts = folderOf(item.path).split("/").filter(Boolean);
        let path = "";
        parts.forEach((part) => {
          path += `/${part}`;
          if (path === "/root" || path.startsWith("/root/")) paths.add(path);
        });
      });
      return paths;
    }

    function renderTree() {
      const tree = document.querySelector<HTMLElement>("#adminTree");
      if (!tree) return;
      const paths = directoryPaths();
      if (!paths.has(currentFolder)) currentFolder = "/root";
      const children = new Map<string, string[]>();
      paths.forEach((path) => {
        if (path === "/root") return;
        const parent = folderOf(path);
        const siblings = children.get(parent) || [];
        siblings.push(path);
        children.set(parent, siblings);
      });
      children.forEach((siblings) => siblings.sort((a, b) => folderName(a).localeCompare(folderName(b), "zh-CN")));
      const rootIcon = document.querySelector<HTMLTemplateElement>("#treeRoot")?.innerHTML || "";
      const folderIcon = document.querySelector<HTMLTemplateElement>("#treeFolder")?.innerHTML || "";
      const chevron = document.querySelector<HTMLTemplateElement>("#treeChevron")?.innerHTML || "";
      const row = (path: string, depth: number, root = false) => {
        const hasChildren = Boolean(children.get(path)?.length);
        const collapsed = collapsedFolders.has(path);
        const name = root ? t("rootDirectory") : shortFolderName(path);
        const indent = root ? 10 : 34 + (Math.max(0, depth) % 4) * 24;
        return `
          <button class="admin-tree-item${currentFolder === path ? " is-active" : ""}${root ? " is-root" : ""}" type="button" data-folder="${esc(path)}" data-has-children="${hasChildren ? "1" : "0"}" style="--tree-indent:${indent}px" title="${esc(root ? t("rootDirectory") : displayPath(path))}"${hasChildren ? ` aria-expanded="${collapsed ? "false" : "true"}"` : ""}>
            <span class="admin-tree-icon">${root ? rootIcon : folderIcon}</span>
            <span class="admin-tree-caret${collapsed ? " is-collapsed" : ""}${hasChildren ? "" : " is-empty"}"${hasChildren ? ` data-tree-toggle="${esc(path)}"` : ""}>${hasChildren ? chevron : ""}</span>
            <span class="admin-tree-name">${esc(name)}</span>
          </button>`;
      };
      const branch = (parent: string, depth: number): string => {
        if (collapsedFolders.has(parent)) return "";
        return (children.get(parent) || []).map((path) => row(path, depth) + branch(path, depth + 1)).join("");
      };
      tree.innerHTML = row("/root", -1, true) + branch("/root", 0);
    }

    function renderRows() {
      const rows = document.querySelector<HTMLElement>("#linkRows");
      const count = document.querySelector<HTMLElement>("#mountCount");
      if (!rows || !count) return;
      const visibleItems = items.filter((item) => isInsideFolder(item.path, currentFolder));
      count.textContent = `${visibleItems.length} ${visibleItems.length === 1 ? t("item") : t("items")}`;
      if (!visibleItems.length) {
        rows.innerHTML = `<tr><td class="empty-row" colspan="6">${esc(t("empty"))}</td></tr>`;
        return;
      }
      const trash = document.querySelector<HTMLTemplateElement>("#tableTrash")?.innerHTML || "";
      rows.innerHTML = visibleItems.map((item) => `
        <tr>
          <td><span class="table-file">${typeIcon(item.kind)}<span>${esc(item.name)}</span></span></td>
          <td><span class="url-cell path-cell" title="${esc(displayPath(item.path))}">${esc(displayPath(item.path))}</span></td>
          <td><span class="type-chip">${esc(t(item.kind))}</span></td>
          <td>${item.kind === "file" ? '<span class="url-cell">-</span>' : item.sub ? '<span class="type-chip">ASS</span>' : item.lrc ? `<span class="type-chip">LRC${item.lrc2 ? " x2" : ""}</span>` : '<span class="url-cell">-</span>'}</td>
          <td><a class="url-cell source-cell" href="${esc(item.url)}" title="${esc(item.url)}" target="_blank" rel="noreferrer">${esc(item.url)}</a></td>
          <td><span class="row-actions"><button class="icon-button danger-button" type="button" data-delete="${esc(item.id)}" title="${esc(t("delete"))}">${trash}<span class="sr-only">${esc(t("delete"))}</span></button></span></td>
        </tr>
      `).join("");
    }

    async function loadLinks() {
      const status = document.querySelector<HTMLElement>("#adminStatus");
      set(status, t("loading"));
      const response = await fetch("/api/admin/links");
      if (response.status === 401) return location.reload();
      const data = (await response.json()) as any;
      if (!data.ok) throw new Error(data.error || t("loadFailed"));
      items = data.items || [];
      set(status);
      renderTree();
      renderRows();
    }

    document.querySelectorAll(".language-select").forEach((element) => {
      const select = element as unknown as HTMLSelectElement;
      select.addEventListener("change", () => {
        lang = select.value as Lang;
        localStorage.setItem("rp_l", lang);
        applyLanguage();
      });
    });

    const saved = localStorage.getItem("rp_l");
    if (saved === "en" || saved === "zh" || saved === "ja") lang = saved;
    applyLanguage();

    async function detectLanguage() {
      try {
        const response = await fetch("/api/public/geo");
        const data = (await response.json()) as { ok?: boolean; lang?: Lang };
        if (!data.ok || (data.lang !== "en" && data.lang !== "zh" && data.lang !== "ja")) return;
        if (localStorage.getItem("rp_l")) return;
        lang = data.lang;
        applyLanguage();
      } catch {
        // English remains the default when location detection is unavailable.
      }
    }

    if (!saved) detectLanguage();

    const loginForm = document.querySelector<HTMLFormElement>("#loginForm");
    loginForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = document.querySelector<HTMLElement>("#loginStatus");
      set(status, t("signingIn"));
      const password = new FormData(loginForm).get("password");
      const response = await fetch("/api/admin/login", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ password })
      });
      const data = (await response.json()) as any;
      if (!data.ok) return set(status, t("wrongPassword"), "error");
      location.reload();
    });

    const dialog = document.querySelector<HTMLDialogElement>("#mountDialog");
    const form = document.querySelector<HTMLFormElement>("#linkForm");
    const kind = document.querySelector("#kindSelect") as HTMLSelectElement | null;
    const urlLabel = document.querySelector<HTMLElement>("#urlLabel");
    const posterField = document.querySelector<HTMLElement>("#posterField");
    const subField = document.querySelector<HTMLElement>("#subField");
    const lrcFields = document.querySelector<HTMLElement>("#lrcFields");
    const descriptionField = document.querySelector<HTMLElement>("#descriptionField");
    const bilingual = document.querySelector<HTMLInputElement>("#bilingualToggle");
    const lrc2Field = document.querySelector<HTMLElement>("#lrc2Field");
    const folderInput = form?.querySelector<HTMLInputElement>('[name="folder"]');
    const toggleFields = () => {
      if (!kind || !urlLabel || !posterField || !subField || !lrcFields || !descriptionField || !bilingual || !lrc2Field) return;
      const file = kind.value === "file";
      urlLabel.dataset.i18n = file ? "url" : "mediaUrl";
      urlLabel.textContent = file ? t("url") : t("mediaUrl");
      posterField.hidden = file;
      subField.hidden = kind.value !== "video";
      lrcFields.hidden = kind.value !== "audio";
      descriptionField.hidden = !file;
      if (file) posterField.querySelector<HTMLInputElement>("input")!.value = "";
      if (kind.value !== "video") subField.querySelector<HTMLInputElement>("input")!.value = "";
      if (kind.value !== "audio") {
        lrcFields.querySelectorAll<HTMLInputElement>('input[type="url"]').forEach((input) => (input.value = ""));
        bilingual.checked = false;
      }
      if (!file) descriptionField.querySelector<HTMLTextAreaElement>("textarea")!.value = "";
      lrc2Field.hidden = kind.value !== "audio" || !bilingual.checked;
      if (!bilingual.checked) lrc2Field.querySelector<HTMLInputElement>("input")!.value = "";
    };

    document.querySelector("#adminTree")?.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const row = target.closest<HTMLElement>("[data-folder]");
      const path = row?.dataset.folder;
      if (!row || !path) return;
      if (target.closest("[data-tree-toggle]") && row.dataset.hasChildren === "1") {
        collapsedFolders.has(path) ? collapsedFolders.delete(path) : collapsedFolders.add(path);
        renderTree();
        return;
      }
      currentFolder = path;
      renderTree();
      renderRows();
    });
    const mobileTreeToggle = document.querySelector<HTMLButtonElement>("#mobileAdminTreeToggle");
    const adminApp = document.querySelector<HTMLElement>(".admin-app");
    mobileTreeToggle?.addEventListener("click", () => {
      const open = !adminApp?.classList.contains("is-sidebar-open");
      adminApp?.classList.toggle("is-sidebar-open", open);
      mobileTreeToggle.setAttribute("aria-expanded", String(open));
    });
    document.querySelector("#adminSidebar")?.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("[data-folder]")) {
        adminApp?.classList.remove("is-sidebar-open");
        mobileTreeToggle?.setAttribute("aria-expanded", "false");
      }
    });
    document.querySelector("#addBtn")?.addEventListener("click", () => {
      if (folderInput) folderInput.value = displayPath(currentFolder);
      dialog?.showModal();
    });
    document.querySelectorAll("[data-close]").forEach((button) => button.addEventListener("click", () => dialog?.close()));
    kind?.addEventListener("change", toggleFields);
    bilingual?.addEventListener("change", toggleFields);
    toggleFields();

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = document.querySelector<HTMLElement>("#formStatus");
      set(status, t("loading"));
      const response = await fetch("/api/admin/links", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form).entries()))
      });
      const data = (await response.json()) as any;
      if (!data.ok) return set(status, data.details || data.error || t("createFailed"), "error");
      form.reset();
      if (folderInput) folderInput.value = displayPath(currentFolder);
      toggleFields();
      set(status, t("created"), "ok");
      await loadLinks();
      setTimeout(() => dialog?.close(), 350);
    });

    document.querySelector("#linkRows")?.addEventListener("click", async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>("[data-delete]");
      if (!button?.dataset.delete || !confirm(t("deleteConfirm"))) return;
      const response = await fetch("/api/admin/links/delete", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ id: button.dataset.delete })
      });
      const data = (await response.json()) as any;
      if (!data.ok) return set(document.querySelector("#adminStatus") as HTMLElement | null, t("deleteFailed"), "error");
      await loadLinks();
    });

    document.querySelector("#refreshLinks")?.addEventListener("click", () => loadLinks().catch((error) => set(document.querySelector("#adminStatus") as HTMLElement | null, error.message, "error")));
    const themeButton = document.querySelector<HTMLButtonElement>("#visitorThemeBtn");
    async function readThemeResponse(response: Response) {
      const text = await response.text();
      let data: { ok?: boolean; theme?: VisitorTheme; error?: string; details?: unknown } = {};
      if (text) {
        try {
          data = JSON.parse(text);
        } catch {
          throw new Error(t("themeFailed"));
        }
      }
      const theme = data.theme;
      if (!response.ok || !data.ok || !theme) {
        const details = typeof data.details === "string" ? data.details : "";
        throw new Error([data.error || t("themeFailed"), details].filter(Boolean).join(" "));
      }
      return { theme };
    }
    async function loadVisitorTheme() {
      if (!themeButton) return;
      const response = await fetch("/api/admin/theme");
      if (response.status === 401) return location.reload();
      const data = await readThemeResponse(response);
      visitorTheme = data.theme;
      renderThemeControl();
    }
    themeButton?.addEventListener("click", async () => {
      const status = document.querySelector<HTMLElement>("#adminStatus");
      themeButton.disabled = true;
      try {
        const response = await fetch("/api/admin/theme", { method: "POST" });
        if (response.status === 401) return location.reload();
        const data = await readThemeResponse(response);
        visitorTheme = data.theme;
        renderThemeControl();
        set(status, `${t("themeChanged")}: ${themeNames[lang][visitorTheme]}`, "ok");
      } catch (error) {
        set(status, error instanceof Error ? error.message : t("themeFailed"), "error");
      } finally {
        themeButton.disabled = false;
      }
    });
    document.querySelector("#logoutBtn")?.addEventListener("click", async () => {
      await fetch("/api/admin/logout", { method: "POST" });
      location.reload();
    });

    if (document.querySelector("#linkRows")) {
      loadLinks().catch((error) => set(document.querySelector("#adminStatus"), error.message, "error"));
      loadVisitorTheme().catch((error) => set(document.querySelector("#adminStatus"), error.message, "error"));
    }
  </script>
</SiteShell>
